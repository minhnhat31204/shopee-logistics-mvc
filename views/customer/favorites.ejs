<%- include('../partials/header') %>

<div class="max-w-6xl mx-auto px-4 py-8">
    <div class="bg-white rounded-sm shadow-sm p-6 mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border border-gray-100">
        <div>
            <div class="flex items-center space-x-2">
                <i class="fa-solid fa-heart text-2xl text-[#ee4d2d]"></i>
                <h1 class="text-xl font-bold text-gray-900">Sản Phẩm Yêu Thích Của Tôi</h1>
            </div>
            <p class="text-xs text-gray-500 mt-1">Danh sách các sản phẩm bạn đã lưu và quan tâm trên Shopee</p>
        </div>
        <div class="flex items-center space-x-3 text-xs">
            <a href="/" class="text-[#ee4d2d] font-semibold hover:underline">
                <i class="fa-solid fa-store mr-1"></i> Khám phá thêm sản phẩm
            </a>
            <span class="text-gray-300">|</span>
            <a href="/my-orders" class="text-gray-600 hover:text-[#ee4d2d]">
                <i class="fa-solid fa-box-archive mr-1"></i> Đơn hàng của tôi
            </a>
        </div>
    </div>

    <% if (!favorites || favorites.length === 0) { %>
        <div class="bg-white rounded-sm p-16 text-center text-gray-400 border border-gray-100">
            <i class="fa-regular fa-heart text-5xl mb-3 text-gray-300"></i>
            <h3 class="text-sm font-semibold text-gray-700">Chưa có sản phẩm yêu thích nào</h3>
            <p class="text-xs text-gray-400 mt-1">Hãy bấm vào biểu tượng trái tim ở các sản phẩm bạn thích để lưu lại tại đây nhé!</p>
            <a href="/" class="inline-block mt-4 px-6 py-2 bg-[#ee4d2d] text-white rounded text-xs font-bold hover:bg-[#d73211] shadow">
                Mua Sắm Ngay
            </a>
        </div>
    <% } else { %>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
            <% favorites.forEach(p => { %>
                <div id="fav-card-<%= p.PRODUCT_ID %>" class="bg-white rounded-sm hover:shadow-lg transition duration-200 border border-gray-100 flex flex-col justify-between group overflow-hidden relative">
                    <!-- Nút icon trái tim đỏ nguyên bản như trang chủ: Bấm để bỏ thích/yêu thích -->
                    <button type="button" onclick="toggleFavInPage(event, <%= p.PRODUCT_ID %>)" title="Bỏ thích sản phẩm này" class="absolute top-2 right-2 z-20 w-7 h-7 rounded-full bg-white/90 hover:bg-white text-red-500 flex items-center justify-center shadow-sm backdrop-blur-xs transition">
                        <i class="fa-solid fa-heart text-xs text-red-500" id="fav-icon-page-<%= p.PRODUCT_ID %>"></i>
                    </button>

                    <a href="/product/<%= p.PRODUCT_ID %>" class="block">
                        <div class="h-44 bg-gray-100 relative overflow-hidden">
                            <img src="<%= p.MAIN_IMAGE %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                            <% if (Number(p.TOTAL_STOCK || 0) <= 0) { %>
                                <div class="absolute inset-0 bg-black/40 flex items-center justify-center p-2 text-center">
                                    <span class="bg-black/75 text-white font-bold text-[11px] px-2.5 py-1 rounded shadow">
                                        TẠM THỜI HẾT HÀNG
                                    </span>
                                </div>
                            <% } else { %>
                                <div class="absolute top-0 left-0 bg-[#ee4d2d] text-white text-[9px] font-bold px-1.5 py-0.5 rounded-br-sm shadow-xs">
                                    Yêu thích
                                </div>
                            <% } %>
                        </div>

                        <div class="p-2.5">
                            <h4 class="text-xs text-gray-800 line-clamp-2 leading-snug group-hover:text-[#ee4d2d] transition">
                                <%= p.PRODUCT_NAME %>
                            </h4>

                            <div class="mt-1 flex items-center justify-between text-[10px] text-gray-400">
                                <span><i class="fa-solid fa-store mr-1 text-gray-400"></i><%= p.SHOP_NAME %></span>
                                <span>Đã bán <%= Number(p.SOLD_COUNT || 0).toLocaleString('vi-VN') %></span>
                            </div>

                            <div class="mt-2 flex items-baseline justify-between">
                                <div class="text-sm font-bold text-[#ee4d2d]">
                                    ₫<%= Number(p.MIN_PRICE || 0).toLocaleString('vi-VN') %>
                                </div>
                                <div class="text-[10px] text-gray-400">
                                    <%= Number(p.TOTAL_STOCK || 0) > 0 ? ('Còn ' + Number(p.TOTAL_STOCK).toLocaleString('vi-VN')) : '<span class="text-red-500 font-bold">Hết hàng</span>' %>
                                </div>
                            </div>
                        </div>
                    </a>

                    <div class="p-2 border-t border-gray-100 bg-gray-50 flex items-center justify-between text-xs">
                        <button type="button" onclick="toggleFavInPage(event, <%= p.PRODUCT_ID %>)" class="text-gray-500 hover:text-red-600 font-medium flex items-center transition">
                            <i class="fa-solid fa-heart mr-1.5 text-xs text-red-500"></i> Yêu thích
                        </button>
                        <a href="/product/<%= p.PRODUCT_ID %>" class="px-2.5 py-1 bg-[#ee4d2d] text-white rounded text-[11px] font-semibold hover:bg-[#d73211]">
                            Xem hàng
                        </a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<script>
async function toggleFavInPage(e, productId) {
    if (e) {
        e.preventDefault();
        e.stopPropagation();
    }
    if (!confirm('Bạn có chắc chắn muốn bỏ thích sản phẩm này khỏi danh sách yêu thích?')) return;
    try {
        const res = await fetch('/api/favorite/toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId })
        });
        const data = await res.json();
        if (data.success && !data.isFavorite) {
            const card = document.getElementById('fav-card-' + productId);
            if (card) {
                card.style.transition = 'all 0.35s ease';
                card.style.opacity = '0';
                card.style.transform = 'scale(0.85)';
                setTimeout(() => {
                    card.remove();
                    const remaining = document.querySelectorAll('[id^="fav-card-"]');
                    if (remaining.length === 0) {
                        location.reload();
                    }
                }, 350);
            }
        }
    } catch(err) {
        alert('Lỗi: ' + err.message);
    }
}
</script>