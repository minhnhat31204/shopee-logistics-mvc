<%- include('../partials/header') %>

<div class="max-w-5xl mx-auto px-4 py-8">
    <div class="mb-6">
        <h1 class="text-xl md:text-2xl font-bold text-gray-900 flex items-center">
            <i class="fa-solid fa-credit-card text-[#ee4d2d] mr-2.5"></i> Thanh Toán & Xác Nhận Đơn Hàng
        </h1>
        <p class="text-xs text-gray-500 mt-1">Vui lòng kiểm tra kỹ địa chỉ nhận hàng và thông tin sản phẩm trước khi hoàn tất đặt hàng.</p>
    </div>

    <% if (error) { %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 rounded-xl text-xs flex items-center">
            <i class="fa-solid fa-triangle-exclamation mr-2 text-base"></i> <%= error %>
        </div>
    <% } %>

    <form action="/checkout" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-8 text-xs">
        <!-- Thông tin giao hàng -->
        <div class="md:col-span-2 space-y-6">
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
                <h3 class="font-bold text-gray-900 text-sm mb-4 flex items-center">
                    <i class="fa-solid fa-location-dot text-orange-500 mr-2"></i> 1. Thông Tin Người Nhận & Địa Chỉ Giao Hàng
                </h3>

                <div class="space-y-3.5">
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">Họ và Tên Người Nhận <span class="text-red-500">*</span></label>
                            <input type="text" name="fullName" value="<%= user ? (user.fullName || user.FULL_NAME || '') : '' %>" required placeholder="Nguyễn Văn A" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-orange-500 bg-white">
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">Số Điện Thoại Liên Lạc <span class="text-red-500">*</span></label>
                            <input type="tel" name="phone" value="<%= user ? (user.phone || user.PHONE || '') : '' %>" required pattern="[0-9]{9,11}" title="Vui lòng nhập số điện thoại hợp lệ (9 - 11 chữ số)" placeholder="0901234567" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-orange-500 bg-white">
                        </div>
                    </div>

                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">Email Nhận Thông Báo Vận Đơn <span class="text-red-500">*</span></label>
                        <input type="email" name="email" value="<%= user ? (user.email || user.EMAIL || '') : '' %>" required placeholder="email@gmail.com" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-orange-500 bg-white">
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <label class="block font-semibold text-gray-700">
                                <i class="fa-solid fa-house-user text-orange-500 mr-1"></i> Địa Chỉ Nhận Hàng Chi Tiết (Số nhà, Đường, Quận/Huyện) <span class="text-red-500">*</span>
                            </label>
                            <% if (user && (user.address || user.ADDRESS)) { %>
                                <span class="text-[11px] text-green-700 bg-green-50 px-2 py-0.5 rounded border border-green-200 font-medium">
                                    <i class="fa-solid fa-circle-check mr-1"></i> Đã tự động điền từ Hồ sơ
                                </span>
                            <% } %>
                        </div>
                        <textarea name="shippingAddress" rows="2" required placeholder="VD: 828 Sư Vạn Hạnh, Phường 12, Quận 10, TP. Hồ Chí Minh" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-orange-500 bg-white"><%= user ? (user.address || user.ADDRESS || '') : '' %></textarea>
                        <p class="text-[11px] text-gray-400 mt-0.5">Vui lòng kiểm tra lại địa chỉ trước khi xác nhận để nhân viên SPX Express giao hàng chính xác.</p>
                    </div>
                </div>

                <!-- HỎI/XÁC NHẬN TẠO TÀI KHOẢN NẾU CHƯA ĐĂNG NHẬP -->
                <% if (!user) { %>
                    <div class="mt-5 pt-5 border-t border-gray-100">
                        <div class="p-4 bg-orange-50/70 border border-orange-200 rounded-xl space-y-3">
                            <label class="flex items-start space-x-3 cursor-pointer">
                                <input type="checkbox" id="chkCreateAccount" name="createAccount" value="yes" onchange="toggleAccountFields(this.checked)" class="mt-0.5 rounded text-orange-600 focus:ring-orange-500 h-4 w-4">
                                <div>
                                    <span class="font-bold text-gray-900 text-xs">Đồng ý tạo tài khoản thành viên Customer từ thông tin đơn hàng này</span>
                                    <p class="text-[11px] text-gray-600 mt-0.5">
                                        Giúp lưu thông tin vào bảng <code class="font-mono text-orange-700 bg-orange-100 px-1 py-0.5 rounded">USERS</code> để tra cứu lịch sử mua sắm, nhận thông báo vận chuyển và tích lũy ưu đãi cho những lần sau.
                                    </p>
                                </div>
                            </label>

                            <!-- Khung nhập username & mật khẩu (mở rộng khi tích chọn) -->
                            <div id="accountCredentialsBox" class="hidden pl-7 pt-2 space-y-3 border-t border-orange-200/60 mt-2">
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="block font-semibold text-gray-700 mb-1">Tên đăng nhập (Username) mong muốn</label>
                                        <input type="text" id="customUsername" name="customUsername" placeholder="Để trống sẽ tự tạo theo Email" class="w-full px-3 py-1.5 bg-white border border-gray-300 rounded-lg focus:outline-none font-mono text-xs">
                                    </div>
                                    <div>
                                        <label class="block font-semibold text-gray-700 mb-1">Mật khẩu đăng nhập</label>
                                        <input type="password" id="customPassword" name="customPassword" placeholder="Tối thiểu 6 ký tự (mặc định: 123456)" class="w-full px-3 py-1.5 bg-white border border-gray-300 rounded-lg focus:outline-none text-xs">
                                    </div>
                                </div>
                                <p class="text-[10px] text-green-700 flex items-center">
                                    <i class="fa-solid fa-circle-check mr-1.5 text-green-600"></i> Sau khi đặt hàng, hệ thống sẽ tự động đăng nhập tài khoản này cho bạn!
                                </p>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Phương thức thanh toán -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
                <h3 class="font-bold text-gray-900 text-sm mb-4 flex items-center">
                    <i class="fa-solid fa-wallet text-orange-500 mr-2"></i> 2. Phương Thức Thanh Toán
                </h3>

                <div class="space-y-2.5">
                    <label class="flex items-center p-3 border border-orange-200 bg-orange-50/50 rounded-xl cursor-pointer">
                        <input type="radio" name="paymentMethod" value="SHOPEEPAY" checked class="text-orange-600 focus:ring-orange-500 mr-3">
                        <div>
                            <div class="font-bold text-gray-800">Ví ShopeePay (Khuyên dùng)</div>
                            <div class="text-[11px] text-gray-500">Tự động kích hoạt thanh toán thành công (Status: PAID) vào bảng PAYMENTS</div>
                        </div>
                    </label>

                    <label class="flex items-center p-3 border border-gray-200 hover:border-gray-300 rounded-xl cursor-pointer">
                        <input type="radio" name="paymentMethod" value="COD" class="text-orange-600 focus:ring-orange-500 mr-3">
                        <div>
                            <div class="font-bold text-gray-800">Thanh toán khi nhận hàng (COD)</div>
                            <div class="text-[11px] text-gray-500">Nhân viên SPX Express thu tiền mặt khi giao hàng tận nơi</div>
                        </div>
                    </label>
                </div>
            </div>
        </div>

        <!-- Tóm tắt đơn hàng & Xác nhận -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 h-max flex flex-col justify-between">
            <div>
                <h3 class="font-bold text-gray-900 text-sm mb-4">Tóm Tắt Đơn Hàng</h3>
                <div class="space-y-3 mb-4 max-h-48 overflow-y-auto divide-y divide-gray-100">
                    <% cart.forEach(c => { %>
                        <div class="pt-2 first:pt-0 flex justify-between items-center">
                            <div>
                                <div class="font-bold text-gray-800"><%= c.productName %></div>
                                <div class="text-[10px] text-gray-400 font-mono"><%= c.variantName %> x<%= c.quantity %></div>
                            </div>
                            <span class="font-bold text-gray-700"><%= (c.price * c.quantity).toLocaleString('vi-VN') %> đ</span>
                        </div>
                    <% }) %>
                </div>

                <div class="pt-3 border-t border-gray-100 space-y-2">
                    <div class="flex justify-between text-gray-600">
                        <span>Tiền hàng:</span>
                        <span><%= total.toLocaleString('vi-VN') %> đ</span>
                    </div>
                    <div class="flex justify-between text-gray-600">
                        <span>Vận chuyển (SPX Express):</span>
                        <span class="text-green-600 font-bold">Miễn phí</span>
                    </div>
                    <div class="flex justify-between items-baseline font-bold text-sm text-gray-900 pt-2 border-t border-gray-100">
                        <span>Tổng thanh toán:</span>
                        <span class="text-xl text-[#ee4d2d] font-bold"><%= total.toLocaleString('vi-VN') %> đ</span>
                    </div>
                </div>
            </div>

            <div class="mt-6 pt-4 border-t border-gray-100">
                <button type="submit" id="btnSubmitOrder" class="w-full h-12 bg-[#ee4d2d] hover:bg-[#d73211] text-white font-semibold rounded-md text-sm shadow-sm hover:shadow transition-colors flex items-center justify-center space-x-2 cursor-pointer uppercase tracking-wide">
                    <span>Đặt Hàng</span>
                </button>
                <p class="text-[11px] text-gray-400 text-center mt-2.5 flex items-center justify-center">
                    <i class="fa-solid fa-shield-halved mr-1 text-green-600"></i> Nhấn "Đặt hàng" đồng nghĩa với việc bạn đồng ý tuân theo Điều khoản Shopee
                </p>
            </div>
        </div>
    </form>
</div>

<script>
function toggleAccountFields(checked) {
    const box = document.getElementById('accountCredentialsBox');
    if (box) {
        if (checked) {
            box.classList.remove('hidden');
        } else {
            box.classList.add('hidden');
        }
    }
}
</script>

<%- include('../partials/footer') %>
