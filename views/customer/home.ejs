<%- include('../partials/header') %>

<!-- Top Banner Grid chuẩn Shopee (Hình 3) -->
<div class="max-w-7xl mx-auto px-4 mt-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <!-- Main Banner Slider -->
        <div class="md:col-span-2 relative rounded-md overflow-hidden shadow-sm h-60 md:h-72 bg-slate-900 group">
            <div id="bannerCarousel" class="h-full relative">
                <% banners.forEach((b, idx) => { %>
                    <div class="main-slide absolute inset-0 transition-opacity duration-500 <%= idx === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none' %>">
                        <img src="<%= b.image %>" class="w-full h-full object-cover">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent flex flex-col justify-end p-6 text-white">
                            <span class="text-[10px] font-black uppercase tracking-wider bg-orange-600 px-2 py-0.5 rounded w-max mb-1">Shopee Mall</span>
                            <h2 class="text-xl md:text-2xl font-black"><%= b.title %></h2>
                            <p class="text-xs text-gray-200 mt-1"><%= b.subtitle %></p>
                        </div>
                    </div>
                <% }) %>
            </div>
            <!-- Slider Dots -->
            <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex space-x-1.5 z-10">
                <% banners.forEach((b, idx) => { %>
                    <button onclick="changeMainSlide(<%= idx %>)" class="w-2 h-2 rounded-full bg-white/60 hover:bg-white"></button>
                <% }) %>
            </div>
        </div>

        <!-- 2 Side Banners Phải (Hình 3) -->
        <div class="flex flex-col space-y-3">
            <div class="flex-1 rounded-md overflow-hidden relative shadow-sm group">
                <img src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=600" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                <div class="absolute inset-0 bg-gradient-to-r from-red-600/80 to-transparent p-4 flex flex-col justify-center text-white">
                    <span class="text-[10px] font-black uppercase bg-white text-red-600 px-1.5 py-0.5 rounded w-max">Nạp Năng Lượng</span>
                    <h3 class="font-bold text-sm mt-1">Giảm 20.000Đ</h3>
                    <p class="text-[11px] text-gray-100">Shopee Food & Tiêu Dùng</p>
                </div>
            </div>
            <div class="flex-1 rounded-md overflow-hidden relative shadow-sm group">
                <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                <div class="absolute inset-0 bg-gradient-to-r from-orange-600/80 to-transparent p-4 flex flex-col justify-center text-white">
                    <span class="text-[10px] font-black uppercase bg-white text-orange-600 px-1.5 py-0.5 rounded w-max">Siêu Thương Hiệu</span>
                    <h3 class="font-bold text-sm mt-1">Voucher 50% + 40%</h3>
                    <p class="text-[11px] text-gray-100">Chính hãng 100%</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Service Icons (Hình 3) -->
<div class="max-w-7xl mx-auto px-4 mt-6">
    <div class="bg-white rounded-md p-4 shadow-sm grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs text-gray-700">
        <div class="flex items-center space-x-3 p-2 rounded hover:bg-gray-50">
            <i class="fa-solid fa-truck-fast text-2xl text-orange-600"></i>
            <div>
                <div class="font-bold">Fulfillment by Shopee</div>
                <div class="text-[11px] text-gray-500">Giao hàng hỏa tốc 2h</div>
            </div>
        </div>
        <div class="flex items-center space-x-3 p-2 rounded hover:bg-gray-50">
            <i class="fa-solid fa-house-chimney text-2xl text-green-600"></i>
            <div>
                <div class="font-bold">Shopee Home</div>
                <div class="text-[11px] text-gray-500">Đời sống & Gia dụng</div>
            </div>
        </div>
        <div class="flex items-center space-x-3 p-2 rounded hover:bg-gray-50">
            <i class="fa-solid fa-gift text-2xl text-yellow-500"></i>
            <div>
                <div class="font-bold">Shopee Rewards</div>
                <div class="text-[11px] text-gray-500">Tích điểm đổi quà</div>
            </div>
        </div>
        <div class="flex items-center space-x-3 p-2 rounded hover:bg-gray-50">
            <i class="fa-solid fa-mobile-screen-button text-2xl text-blue-600"></i>
            <div>
                <div class="font-bold">Nạp Thẻ & Dịch Vụ</div>
                <div class="text-[11px] text-gray-500">Thanh toán tiện lợi</div>
            </div>
        </div>
    </div>
</div>

<!-- CATEGORIES (Danh mục chuẩn Shopee - Hình 3) -->
<div class="max-w-7xl mx-auto px-4 mt-6">
    <div class="bg-white rounded-md shadow-sm border border-gray-100 overflow-hidden">
        <div class="p-3 border-b border-gray-100 text-xs font-bold text-gray-600 uppercase tracking-wider">
            DANH MỤC
        </div>
        <div class="grid grid-cols-3 sm:grid-cols-6 md:grid-cols-8 divide-x divide-y divide-gray-100 text-center text-xs">
            <% categories.forEach(cat => { %>
                <a href="/?cat=<%= cat.CATEGORY_ID %>" class="p-4 hover:shadow-md transition flex flex-col items-center group">
                    <img src="<%= cat.IMAGE_URL || 'https://images.unsplash.com/photo-1542838132-92c53300491e?w=120' %>" class="w-14 h-14 object-cover rounded-full mb-2 group-hover:scale-105 transition">
                    <span class="text-[11px] font-medium text-gray-700 line-clamp-2"><%= cat.CATEGORY_NAME %></span>
                </a>
            <% }) %>
            <a href="/?q=Áo" class="p-4 hover:shadow-md transition flex flex-col items-center group">
                <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=120" class="w-14 h-14 object-cover rounded-full mb-2 group-hover:scale-105 transition">
                <span class="text-[11px] font-medium text-gray-700">Thời Trang Nam</span>
            </a>
            <a href="/?q=Điện thoại" class="p-4 hover:shadow-md transition flex flex-col items-center group">
                <img src="https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=120" class="w-14 h-14 object-cover rounded-full mb-2 group-hover:scale-105 transition">
                <span class="text-[11px] font-medium text-gray-700">Điện Thoại & Phụ Kiện</span>
            </a>
            <a href="/?q=Gia dụng" class="p-4 hover:shadow-md transition flex flex-col items-center group">
                <img src="https://images.unsplash.com/photo-1584269600464-37b1b58a9fe7?w=120" class="w-14 h-14 object-cover rounded-full mb-2 group-hover:scale-105 transition">
                <span class="text-[11px] font-medium text-gray-700">Thiết Bị Điện Gia Dụng</span>
            </a>
            <a href="/?q=Mỹ phẩm" class="p-4 hover:shadow-md transition flex flex-col items-center group">
                <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=120" class="w-14 h-14 object-cover rounded-full mb-2 group-hover:scale-105 transition">
                <span class="text-[11px] font-medium text-gray-700">Sắc Đẹp & Chăm Sóc</span>
            </a>
            <a href="/?q=Bách hóa" class="p-4 hover:shadow-md transition flex flex-col items-center group">
                <img src="https://images.unsplash.com/photo-1578916171728-46686eac8d58?w=120" class="w-14 h-14 object-cover rounded-full mb-2 group-hover:scale-105 transition">
                <span class="text-[11px] font-medium text-gray-700">Bách Hóa Online</span>
            </a>
            <a href="/?q=Đồ chơi" class="p-4 hover:shadow-md transition flex flex-col items-center group">
                <img src="https://images.unsplash.com/photo-1566576912321-d58ddd7a6088?w=120" class="w-14 h-14 object-cover rounded-full mb-2 group-hover:scale-105 transition">
                <span class="text-[11px] font-medium text-gray-700">Đồ Chơi Trẻ Em</span>
            </a>
        </div>
    </div>
</div>

<!-- FLASH SALE (Hình 4) -->
<div class="max-w-7xl mx-auto px-4 mt-6">
    <div class="bg-white rounded-md shadow-sm border border-gray-100 p-4">
        <div class="flex justify-between items-center mb-4">
            <div class="flex items-center space-x-3">
                <div class="text-[#ee4d2d] font-black text-lg italic flex items-center">
                    <i class="fa-solid fa-bolt mr-1 text-xl animate-pulse"></i> FLASH SALE
                </div>
                <div class="flex items-center space-x-1 text-xs font-mono font-bold text-white">
                    <span id="flashSaleHours" class="bg-black px-1.5 py-0.5 rounded">02</span>
                    <span class="text-black">:</span>
                    <span id="flashSaleMinutes" class="bg-black px-1.5 py-0.5 rounded">45</span>
                    <span class="text-black">:</span>
                    <span id="flashSaleSeconds" class="bg-black px-1.5 py-0.5 rounded">18</span>
                </div>
            </div>
            <a href="#dailyDiscover" class="text-xs text-[#ee4d2d] font-semibold hover:underline">Xem Tất Cả &gt;</a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-3">
            <% products.slice(0, 6).forEach(p => { %>
                <a href="/product/<%= p.PRODUCT_ID %>" class="flex flex-col text-center p-2 rounded hover:shadow transition border border-gray-100">
                    <div class="h-36 bg-gray-100 rounded overflow-hidden relative">
                        <img src="<%= p.MAIN_IMAGE %>" class="w-full h-full object-cover">
                    </div>
                    <div class="text-sm font-bold text-[#ee4d2d] mt-2">
                        <%= Number(p.MIN_PRICE || 28000).toLocaleString('vi-VN') %> ₫
                    </div>
                    <div class="mt-1 bg-red-100 h-2.5 rounded-full overflow-hidden relative">
                        <div class="bg-[#ee4d2d] h-full rounded-full" style="width: 78%;"></div>
                    </div>
                    <span class="text-[10px] text-gray-500 mt-1 uppercase font-bold">ĐANG BÁN CHẠY</span>
                </a>
            <% }) %>
        </div>
    </div>
</div>

<!-- DAILY DISCOVER / GỢI Ý HÔM NAY (Hình 5 chuẩn Shopee) -->
<div id="dailyDiscover" class="max-w-7xl mx-auto px-4 mt-8 mb-12">
    <!-- Header Tab & BỘ LỌC TÌM KIẾM SẢN PHẨM (Yêu cầu 6 & 7) -->
    <div class="bg-white p-4 rounded-sm shadow-sm border border-gray-100 mb-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between pb-3 border-b border-gray-100 gap-3">
            <div class="flex items-center space-x-2">
                <span class="w-2.5 h-6 bg-[#ee4d2d] rounded-xs"></span>
                <h3 class="font-bold text-gray-800 text-base uppercase tracking-wider">
                    GỢI Ý HÔM NAY & DANH SÁCH SẢN PHẨM
                </h3>
            </div>
            <% if (currentKeyword || currentCat || currentShop || currentSort) { %>
                <a href="/" class="text-xs text-[#ee4d2d] hover:underline flex items-center font-medium">
                    <i class="fa-solid fa-rotate-left mr-1"></i> Làm mới bộ lọc (Hiện tất cả)
                </a>
            <% } %>
        </div>

        <!-- Thanh Bộ Lọc Shopee Chuẩn (Tìm kiếm AJAX mượt mà không reload trang, giữ nguyên vị trí cuộn) -->
        <form id="filterProductForm" onsubmit="handleAjaxProductFilter(event)" class="mt-3 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-2 text-xs">
            <% if (currentKeyword) { %>
                <input type="hidden" name="q" id="filterKeywordInput" value="<%= currentKeyword %>">
            <% } %>

            <!-- Lọc theo Cửa hàng (Shop) -->
            <div>
                <label class="block text-[11px] font-semibold text-gray-500 mb-1">Cửa hàng (Shop):</label>
                <select name="shop" class="w-full px-2.5 py-1.5 border border-gray-300 rounded focus:border-[#ee4d2d] focus:outline-none bg-white">
                    <option value="">Tất cả Cửa hàng</option>
                    <% if (typeof shops !== 'undefined') { %>
                        <% shops.forEach(s => { %>
                            <option value="<%= s.SHOP_ID %>" <%= currentShop == s.SHOP_ID ? 'selected' : '' %>>
                                <%= s.SHOP_NAME %>
                            </option>
                        <% }) %>
                    <% } %>
                </select>
            </div>

            <!-- Lọc theo Danh mục (Phân cấp Danh mục Cha & Danh mục Con) -->
            <div>
                <label class="block text-[11px] font-semibold text-gray-500 mb-1">Danh mục ngành hàng:</label>
                <select name="cat" class="w-full px-2.5 py-1.5 border border-gray-300 rounded focus:border-[#ee4d2d] focus:outline-none bg-white font-medium">
                    <option value="">Tất cả Danh mục</option>
                    <% 
                        const parentCats = categories.filter(c => !c.PARENT_CATEGORY_ID);
                        parentCats.forEach(parent => {
                            const childCats = categories.filter(c => c.PARENT_CATEGORY_ID == parent.CATEGORY_ID);
                    %>
                        <optgroup label="📂 <%= parent.CATEGORY_NAME %>">
                            <option value="<%= parent.CATEGORY_ID %>" <%= currentCat == parent.CATEGORY_ID ? 'selected' : '' %>>
                                &bull; Tất cả <%= parent.CATEGORY_NAME %>
                            </option>
                            <% childCats.forEach(child => { %>
                                <option value="<%= child.CATEGORY_ID %>" <%= currentCat == child.CATEGORY_ID ? 'selected' : '' %>>
                                    &nbsp;&nbsp;&nbsp;&nbsp;↳ <%= child.CATEGORY_NAME %>
                                </option>
                            <% }) %>
                        </optgroup>
                    <% }) %>
                    <% 
                        // Các danh mục độc lập nếu chưa gán parent
                        const orphanCats = categories.filter(c => c.PARENT_CATEGORY_ID && !parentCats.some(p => p.CATEGORY_ID == c.PARENT_CATEGORY_ID));
                        if (orphanCats.length > 0) {
                    %>
                        <optgroup label="Danh mục khác">
                            <% orphanCats.forEach(oc => { %>
                                <option value="<%= oc.CATEGORY_ID %>" <%= currentCat == oc.CATEGORY_ID ? 'selected' : '' %>>
                                    <%= oc.CATEGORY_NAME %>
                                </option>
                            <% }) %>
                        </optgroup>
                    <% } %>
                </select>
            </div>

            <!-- Sắp xếp theo Tiêu chí -->
            <div>
                <label class="block text-[11px] font-semibold text-gray-500 mb-1">Sắp xếp theo:</label>
                <select name="sort" class="w-full px-2.5 py-1.5 border border-gray-300 rounded focus:border-[#ee4d2d] focus:outline-none bg-white">
                    <option value="">Phổ biến nhất</option>
                    <option value="sold_desc" <%= currentSort === 'sold_desc' ? 'selected' : '' %>>Bán chạy nhất</option>
                    <option value="new_desc" <%= currentSort === 'new_desc' ? 'selected' : '' %>>Mới nhất</option>
                    <option value="price_asc" <%= currentSort === 'price_asc' ? 'selected' : '' %>>Giá: Thấp đến Cao</option>
                    <option value="price_desc" <%= currentSort === 'price_desc' ? 'selected' : '' %>>Giá: Cao đến Thấp</option>
                </select>
            </div>

            <!-- Tình trạng hàng -->
            <div>
                <label class="block text-[11px] font-semibold text-gray-500 mb-1">Tình trạng kho:</label>
                <div class="px-2.5 py-1.5 text-gray-600 bg-gray-50 rounded border border-gray-200 flex items-center justify-between">
                    <span>Đang hiển thị (<strong class="text-[#ee4d2d]"><%= products.length %></strong>)</span>
                </div>
            </div>

            <!-- Nút hành động: Lọc & Reset -->
            <div class="flex items-end space-x-1.5">
                <button type="submit" class="flex-1 py-1.5 bg-[#ee4d2d] hover:bg-[#d73211] text-white font-bold rounded shadow-sm text-xs flex items-center justify-center">
                    <i class="fa-solid fa-filter mr-1"></i> Áp dụng
                </button>
                <a href="/" title="Xóa toàn bộ tìm kiếm & bộ lọc" class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded text-xs flex items-center justify-center">
                    <i class="fa-solid fa-arrows-rotate mr-1"></i> Làm mới
                </a>
            </div>
        </form>
    </div>

    <!-- Product Grid -->
    <div id="productGridContainer" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2.5">
        <% products.forEach(p => { %>
            <div class="bg-white rounded-sm hover:shadow-md hover:-translate-y-0.5 transition duration-200 border border-gray-100 flex flex-col justify-between group overflow-hidden relative">
                <!-- Nút yêu thích đặt tinh tế ở góc trên phải ảnh (Đồng bộ trái tim đỏ nếu đã yêu thích) -->
                <% const isFav = (Number(p.IS_FAVORITE || 0) === 1); %>
                <button type="button" onclick="quickToggleFav(event, <%= p.PRODUCT_ID %>)" title="<%= isFav ? 'Bỏ thích' : 'Yêu thích' %>" class="absolute top-2 right-2 z-20 w-7 h-7 rounded-full bg-white/90 hover:bg-white text-gray-400 hover:text-red-500 flex items-center justify-center shadow-sm backdrop-blur-xs transition">
                    <i class="<%= isFav ? 'fa-solid fa-heart text-red-500' : 'fa-regular fa-heart text-gray-400' %> text-xs" id="fav-icon-home-<%= p.PRODUCT_ID %>"></i>
                </button>

                <a href="/product/<%= p.PRODUCT_ID %>" class="block flex-1 flex flex-col">
                    <!-- Ảnh sản phẩm -->
                    <div class="h-44 bg-gray-50 relative overflow-hidden flex items-center justify-center">
                        <img src="<%= p.MAIN_IMAGE %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                        
                        <!-- Badge Trạng thái Kho (Yêu cầu 2) -->
                        <% if (Number(p.TOTAL_STOCK || 0) <= 0) { %>
                            <div class="absolute inset-0 bg-black/45 backdrop-blur-[1px] flex items-center justify-center p-2 text-center">
                                <span class="bg-black/80 text-white font-bold text-[11px] tracking-wider px-3 py-1 rounded-sm shadow border border-white/20 uppercase">
                                    Tạm hết hàng
                                </span>
                            </div>
                        <% } else { %>
                            <div class="absolute top-0 left-0 bg-[#ee4d2d] text-white text-[9px] font-bold px-1.5 py-0.5 rounded-br-sm shadow-xs">
                                Yêu thích
                            </div>
                        <% } %>
                    </div>

                    <!-- Thông tin -->
                    <div class="p-2.5 flex-1 flex flex-col justify-between">
                        <div>
                            <h4 class="text-xs text-gray-800 line-clamp-2 leading-snug group-hover:text-[#ee4d2d] transition">
                                <%= p.PRODUCT_NAME %>
                            </h4>

                            <!-- Shop tag & Trạng thái hàng -->
                            <div class="mt-1 flex items-center justify-between text-[11px] text-gray-400">
                                <span class="truncate max-w-[105px] flex items-center text-gray-500">
                                    <i class="fa-solid fa-store mr-1 text-[10px] text-gray-400"></i><%= p.SHOP_NAME %>
                                </span>
                                <% if (Number(p.TOTAL_STOCK || 0) <= 0) { %>
                                    <span class="text-red-500 font-semibold text-[10px] bg-red-50 px-1 py-0.2 rounded border border-red-100">Hết hàng</span>
                                <% } else { %>
                                    <span class="text-emerald-600 font-medium text-[10px]">Kho: <%= Number(p.TOTAL_STOCK).toLocaleString('vi-VN') %></span>
                                <% } %>
                            </div>
                        </div>

                        <!-- Phần Chân thẻ: Giá & Đã bán & Nơi bán -->
                        <div class="mt-2.5 pt-2 border-t border-gray-50">
                            <div class="flex items-baseline justify-between">
                                <div class="text-sm font-bold text-[#ee4d2d]">
                                    <span class="text-[11px] font-semibold">₫</span><%= Number(p.MIN_PRICE || 0).toLocaleString('vi-VN') %>
                                </div>
                                <div class="text-[10px] text-gray-400">
                                    Đã bán <%= Number(p.SOLD_COUNT || 0).toLocaleString('vi-VN') %>
                                </div>
                            </div>
                            <div class="text-[10px] text-gray-400 text-right mt-1">TP. Hồ Chí Minh</div>
                        </div>
                    </div>
                </a>
            </div>
        <% }) %>
    </div>

    <!-- Nút Xem Thêm chuẩn Shopee -->
    <div class="text-center mt-6">
        <a href="#dailyDiscover" class="inline-block px-12 py-2.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-xs font-semibold rounded-sm shadow-sm">
            Xem Thêm
        </a>
    </div>
</div>

<script>

async function quickToggleFav(e, productId) {
    e.preventDefault();
    e.stopPropagation();
    try {
        const res = await fetch('/api/favorite/toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId })
        });
        if (res.status === 401) {
            if (confirm('Vui lòng đăng nhập để lưu sản phẩm yêu thích. Chuyển đến trang Đăng nhập?')) {
                window.location.href = '/login?redirect=/';
            }
            return;
        }
        const data = await res.json();
        if (data.success) {
            const icon = document.getElementById('fav-icon-home-' + productId);
            if (icon) {
                if (data.isFavorite) {
                    icon.className = 'fa-solid fa-heart text-xs text-red-500 animate-bounce';
                    setTimeout(() => icon.classList.remove('animate-bounce'), 800);
                } else {
                    icon.className = 'fa-regular fa-heart text-xs text-gray-400';
                }
            }
        }
    } catch(err) {
        console.error('Lỗi favorite:', err);
    }
}

// Xử lý Lọc Sản Phẩm qua AJAX (Không tải lại trang, giữ nguyên vị trí scroll)
async function handleAjaxProductFilter(e) {
    e.preventDefault();
    const form = document.getElementById('filterProductForm');
    const formData = new FormData(form);
    const params = new URLSearchParams(formData);

    // Cập nhật URL trên thanh địa chỉ không tải lại trang
    const newUrl = '/?' + params.toString() + '#dailyDiscover';
    window.history.pushState({}, '', newUrl);

    try {
        // Fetch HTML nội dung từ server
        const res = await fetch(newUrl);
        const html = await res.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        // Cập nhật lưới sản phẩm
        const newGrid = doc.getElementById('productGridContainer');
        const curGrid = document.getElementById('productGridContainer');
        if (newGrid && curGrid) {
            curGrid.innerHTML = newGrid.innerHTML;
        }

        // Cập nhật số lượng sản phẩm hiển thị trong nhãn
        const newCount = doc.querySelector('#filterProductForm strong');
        const curCount = document.querySelector('#filterProductForm strong');
        if (newCount && curCount) {
            curCount.innerText = newCount.innerText;
        }
    } catch (err) {
        console.error('Lỗi lọc sản phẩm AJAX:', err);
        form.submit(); // fallback
    }
}

let mainSlideIdx = 0;
const mainSlides = document.querySelectorAll('.main-slide');
function changeMainSlide(idx) {
    if (!mainSlides.length) return;
    mainSlides[mainSlideIdx].classList.add('opacity-0', 'pointer-events-none');
    mainSlides[mainSlideIdx].classList.remove('opacity-100');
    mainSlideIdx = idx;
    mainSlides[mainSlideIdx].classList.remove('opacity-0', 'pointer-events-none');
    mainSlides[mainSlideIdx].classList.add('opacity-100');
}
setInterval(() => {
    if (mainSlides.length > 0) {
        changeMainSlide((mainSlideIdx + 1) % mainSlides.length);
    }
}, 4000);

// Đồng hồ đếm ngược Flash Sale (Countdown Timer chạy thực tế)
(function startFlashSaleCountdown() {
    // Thiết lập mốc đếm ngược: 2 giờ 45 phút 18 giây (9918 giây)
    let totalSeconds = 2 * 3600 + 45 * 60 + 18;

    // Lưu mốc thời gian kết thúc vào localStorage để không bị reset khi tải lại trang
    const storageKey = 'shopee_flash_sale_end';
    let endTime = localStorage.getItem(storageKey);
    const now = Date.now();

    if (!endTime || Number(endTime) <= now) {
        endTime = now + totalSeconds * 1000;
        localStorage.setItem(storageKey, endTime);
    }

    function updateTimer() {
        const remainingMs = Math.max(0, Number(endTime) - Date.now());
        const remainingSec = Math.floor(remainingMs / 1000);

        const hours = Math.floor(remainingSec / 3600);
        const minutes = Math.floor((remainingSec % 3600) / 60);
        const seconds = remainingSec % 60;

        const hEl = document.getElementById('flashSaleHours');
        const mEl = document.getElementById('flashSaleMinutes');
        const sEl = document.getElementById('flashSaleSeconds');

        if (hEl) hEl.textContent = String(hours).padStart(2, '0');
        if (mEl) mEl.textContent = String(minutes).padStart(2, '0');
        if (sEl) sEl.textContent = String(seconds).padStart(2, '0');

        if (remainingSec <= 0) {
            // Khi hết giờ thì tự tạo phiên Flash Sale mới (ví dụ 3 giờ)
            localStorage.setItem(storageKey, Date.now() + 3 * 3600 * 1000);
        }
    }

    updateTimer();
    setInterval(updateTimer, 1000);
})();
</script>

