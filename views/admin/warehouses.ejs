<%- include('admin-layout-top') %>

<div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-3">
    <div>
        <h2 class="text-xl font-bold text-gray-900">Quản Lý Kho Hàng (Warehouses)</h2>
        <p class="text-xs text-gray-500">Danh sách trung tâm logistics tổng Shopee. Quy tắc: Cho phép xóa kho có kệ trống; Chặn xóa khi kho đang có hàng tồn kho.</p>
    </div>
    <div class="flex items-center space-x-2">
        <button onclick="document.getElementById('modalCreateWarehouse').classList.remove('hidden')" class="px-3.5 py-2 bg-orange-600 hover:bg-orange-700 text-white rounded-lg text-xs font-bold shadow flex items-center">
            <i class="fa-solid fa-plus mr-1.5"></i> Thêm Kho Hàng Mới
        </button>
        <a href="/admin/locations" class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-bold shadow flex items-center">
            <i class="fa-solid fa-layer-group mr-1.5"></i> Xem Vị Trí Kệ
        </a>
    </div>
</div>

<% if (msg) { %>
    <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-700 rounded-lg text-sm flex items-center">
        <i class="fa-solid fa-circle-check mr-2"></i> <%= msg %>
    </div>
<% } %>

<% if (err) { %>
    <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm flex items-center">
        <i class="fa-solid fa-triangle-exclamation mr-2 text-lg text-red-600"></i>
        <div class="font-semibold text-sm"><%= err %></div>
    </div>
<% } %>

<!-- Bảng Danh Sách Kho Hàng -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-6">
    <div class="p-3 bg-gray-50 border-b border-gray-100 flex items-center justify-between gap-3">
        <div class="relative flex-1 max-w-md">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-gray-400 text-xs"></i>
            <input type="text" id="filterInput_warehousesTable" onkeyup="filterTableRows('warehousesTable', this.value)" placeholder="Tìm theo tên kho, địa chỉ..." class="w-full pl-8 pr-8 py-1.5 text-xs bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-orange-500 shadow-sm">
            <button type="button" onclick="clearTableFilter('warehousesTable')" title="Xóa từ khóa & Làm mới" class="absolute right-2.5 top-2 text-gray-400 hover:text-red-600 text-xs">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="flex items-center space-x-2">
            <span id="filterCount_warehousesTable" class="text-[11px] text-gray-400"></span>
            <button type="button" onclick="clearTableFilter('warehousesTable')" class="px-3 py-1.5 bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 rounded-lg text-xs font-semibold shadow-sm flex items-center">
                <i class="fa-solid fa-arrows-rotate mr-1"></i> Làm mới
            </button>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table id="warehousesTable" class="w-full text-left text-xs text-gray-600">
            <thead class="bg-gray-50 text-gray-500 uppercase tracking-wider text-[11px]">
                <tr>
                    <th class="p-3">ID Kho</th>
                    <th class="p-3">Tên Kho Hàng</th>
                    <th class="p-3">Địa Chỉ</th>
                    <th class="p-3">Số Lượng Kệ</th>
                    <th class="p-3">Tổng Tồn Kho</th>
                    <th class="p-3 text-right">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <% if (warehouses.length === 0) { %>
                    <tr>
                        <td colspan="6" class="p-6 text-center text-gray-400 italic">Chưa có kho hàng nào.</td>
                    </tr>
                <% } %>
                <% warehouses.forEach(w => { %>
                    <tr class="hover:bg-gray-50">
                        <td class="p-3 font-mono font-bold text-gray-500">#<%= w.WAREHOUSE_ID %></td>
                        <td class="p-3 font-bold text-gray-900 text-sm">
                            <i class="fa-solid fa-warehouse mr-1.5 text-orange-600"></i><%= w.WAREHOUSE_NAME %>
                        </td>
                        <td class="p-3 text-gray-600">
                            <i class="fa-solid fa-location-dot mr-1 text-gray-400"></i><%= w.ADDRESS %>
                        </td>
                        <td class="p-3 font-semibold text-indigo-700">
                            <a href="/admin/locations?whId=<%= w.WAREHOUSE_ID %>" class="hover:underline flex items-center">
                                <span class="px-2 py-0.5 bg-indigo-50 rounded border border-indigo-100"><%= w.TOTAL_LOCATIONS || 0 %> vị trí kệ</span>
                            </a>
                        </td>
                        <td class="p-3 font-bold text-sm">
                            <% if (Number(w.TOTAL_STOCK || 0) > 0) { %>
                                <span class="text-orange-600"><%= Number(w.TOTAL_STOCK).toLocaleString('vi-VN') %> sản phẩm</span>
                            <% } else { %>
                                <span class="text-gray-400 font-normal">Trống (0 sp)</span>
                            <% } %>
                        </td>
                        <td class="p-3 text-right space-x-1 whitespace-nowrap">
                            <a href="/admin/locations?whId=<%= w.WAREHOUSE_ID %>" class="px-2.5 py-1 bg-indigo-50 border border-indigo-200 text-indigo-700 hover:bg-indigo-100 rounded text-[11px] font-semibold inline-flex items-center">
                                <i class="fa-solid fa-layer-group mr-1"></i> Xem Kệ
                            </a>
                            <button onclick="openEditWarehouseModal(<%= w.WAREHOUSE_ID %>, '<%= w.WAREHOUSE_NAME.replace(/'/g, "\\'") %>', '<%= w.ADDRESS.replace(/'/g, "\\'") %>')" class="px-2.5 py-1 bg-amber-500 hover:bg-amber-600 text-white rounded text-[11px] font-semibold">
                                <i class="fa-solid fa-pen-to-square mr-1"></i> Sửa
                            </button>
                            <form action="/admin/warehouses/delete" method="POST" class="inline-block" onsubmit="return confirm('Bạn có chắc chắn muốn xóa kho này? Quy tắc: Không thể xóa kho khi đang có hàng tồn kho; Có thể xóa kho khi đang có kệ trống.')">
                                <input type="hidden" name="warehouseId" value="<%= w.WAREHOUSE_ID %>">
                                <button type="submit" class="px-2.5 py-1 bg-red-600 hover:bg-red-700 text-white rounded text-[11px] font-semibold">
                                    <i class="fa-solid fa-trash mr-1"></i> Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm Kho Hàng Mới -->
<div id="modalCreateWarehouse" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 relative">
        <button onclick="document.getElementById('modalCreateWarehouse').classList.add('hidden')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-base font-bold text-gray-900 mb-3 flex items-center">
            <i class="fa-solid fa-warehouse text-orange-600 mr-2"></i> Khởi Tạo Kho Hàng Mới
        </h3>
        <form action="/admin/warehouses/create" method="POST" class="space-y-3.5 text-xs">
            <input type="hidden" name="redirectUrl" value="/admin/warehouses">
            <div>
                <label class="block font-semibold text-gray-700 mb-1">Tên Kho Hàng *</label>
                <input type="text" name="warehouseName" placeholder="VD: Kho Shopee Tân Bình" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-orange-500">
            </div>
            <div>
                <label class="block font-semibold text-gray-700 mb-1">Địa Chỉ Kho *</label>
                <input type="text" name="address" placeholder="VD: Số 123 Đường Cộng Hòa, Q. Tân Bình, TP.HCM" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-orange-500">
            </div>
            <div class="pt-2 flex justify-end space-x-2">
                <button type="button" onclick="document.getElementById('modalCreateWarehouse').classList.add('hidden')" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-semibold">Hủy</button>
                <button type="submit" class="px-5 py-2 bg-orange-600 hover:bg-orange-700 text-white rounded-lg font-bold shadow">Khởi Tạo Kho</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Sửa Kho Hàng -->
<div id="modalEditWarehouse" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 relative">
        <button onclick="document.getElementById('modalEditWarehouse').classList.add('hidden')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-base font-bold text-gray-900 mb-3 flex items-center">
            <i class="fa-solid fa-pen-to-square text-amber-600 mr-2"></i> Chỉnh Sửa Thông Tin Kho
        </h3>
        <form action="/admin/warehouses/update" method="POST" class="space-y-3.5 text-xs">
            <input type="hidden" name="redirectUrl" value="/admin/warehouses">
            <input type="hidden" id="editWhId" name="warehouseId">
            <div>
                <label class="block font-semibold text-gray-700 mb-1">Tên Kho Hàng *</label>
                <input type="text" id="editWhName" name="warehouseName" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-orange-500">
            </div>
            <div>
                <label class="block font-semibold text-gray-700 mb-1">Địa Chỉ Kho *</label>
                <input type="text" id="editWhAddress" name="address" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-orange-500">
            </div>
            <div class="pt-2 flex justify-end space-x-2">
                <button type="button" onclick="document.getElementById('modalEditWarehouse').classList.add('hidden')" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-semibold">Hủy</button>
                <button type="submit" class="px-5 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg font-bold shadow">Lưu Cập Nhật</button>
            </div>
        </form>
    </div>
</div>

<%- include('admin-layout-bottom') %>

<script>
function filterTableRows(tableId, query) {
    query = (query || '').toLowerCase().trim();
    const table = document.getElementById(tableId);
    if (!table) return;
    const rows = table.querySelectorAll('tbody tr');
    let visibleCount = 0;
    rows.forEach(r => {
        const text = r.innerText.toLowerCase();
        if (text.includes(query)) {
            r.style.display = '';
            visibleCount++;
        } else {
            r.style.display = 'none';
        }
    });
    const countEl = document.getElementById('filterCount_' + tableId);
    if (countEl) {
        countEl.innerText = query ? ('Hiển thị: ' + visibleCount + '/' + rows.length) : '';
    }
}

function clearTableFilter(tableId) {
    const input = document.getElementById('filterInput_' + tableId);
    if (input) input.value = '';
    filterTableRows(tableId, '');
}

function openEditWarehouseModal(id, name, address) {
    document.getElementById('editWhId').value = id;
    document.getElementById('editWhName').value = name;
    document.getElementById('editWhAddress').value = address;
    document.getElementById('modalEditWarehouse').classList.remove('hidden');
}
</script>