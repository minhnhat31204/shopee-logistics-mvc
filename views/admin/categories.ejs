<%- include('admin-layout-top') %>

<div class="flex justify-between items-center mb-6">
    <div>
        <h2 class="text-xl font-bold text-gray-900">Quản Lý Danh Mục Sản Phẩm (Phân Cấp)</h2>
        <p class="text-xs text-gray-500">Tạo danh mục cha, danh mục con, sửa và xóa theo quy trình ràng buộc CSDL.</p>
    </div>
    <button onclick="document.getElementById('modalCreateCategory').classList.remove('hidden')" class="px-4 py-2 bg-orange-600 hover:bg-orange-700 text-white rounded-lg text-sm font-semibold shadow flex items-center">
        <i class="fa-solid fa-plus mr-2"></i> Thêm Danh Mục Mới
    </button>
</div>

<% if (msg) { %>
    <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-700 rounded-lg text-sm flex items-center">
        <i class="fa-solid fa-circle-check mr-2"></i> <%= msg %>
    </div>
<% } %>

<% if (err) { %>
    <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm flex items-center">
        <i class="fa-solid fa-circle-exclamation mr-2"></i> <%= err %>
    </div>
<% } %>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    
<!-- Thanh Tìm Kiếm Nhanh & Làm Mới (Yêu cầu 6) -->
<div class="p-3 bg-gray-50 border-b border-gray-100 flex items-center justify-between gap-3">
    <div class="relative flex-1 max-w-md">
        <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-gray-400 text-xs"></i>
        <input type="text" id="filterInput_adminCategoriesTable" onkeyup="filterTableRows('adminCategoriesTable', this.value)" placeholder="Tìm theo tên danh mục, danh mục cha..." class="w-full pl-8 pr-8 py-1.5 text-xs bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-orange-500 shadow-sm">
        <button type="button" onclick="clearTableFilter('adminCategoriesTable')" title="Xóa từ khóa & Làm mới" class="absolute right-2.5 top-2 text-gray-400 hover:text-red-600 text-xs">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
    <div class="flex items-center space-x-2">
        <span id="filterCount_adminCategoriesTable" class="text-[11px] text-gray-400"></span>
        <button type="button" onclick="clearTableFilter('adminCategoriesTable')" class="px-3 py-1.5 bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 rounded-lg text-xs font-semibold shadow-sm flex items-center">
            <i class="fa-solid fa-arrows-rotate mr-1"></i> Làm mới
        </button>
    </div>
</div>

<div class="overflow-x-auto">
        <table id="adminCategoriesTable" class="w-full text-left text-xs text-gray-600">
            <thead class="bg-gray-50 text-gray-500 uppercase tracking-wider text-[11px]">
                <tr>
                    <th class="p-3">ID</th>
                    <th class="p-3">Hình Ảnh</th>
                    <th class="p-3">Tên Danh Mục</th>
                    <th class="p-3">Cấp Danh Mục</th>
                    <th class="p-3">Danh Mục Cha (Parent)</th>
                    <th class="p-3 text-right">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <% categories.forEach(c => { %>
                    <tr class="hover:bg-gray-50">
                        <td class="p-3 font-mono font-bold text-gray-500">#<%= c.CATEGORY_ID %></td>
                        <td class="p-3">
                            <img src="<%= c.IMAGE_URL || 'https://images.unsplash.com/photo-1542838132-92c53300491e?w=100' %>" class="w-10 h-10 rounded-lg object-cover border border-gray-200">
                        </td>
                        <td class="p-3 font-bold text-gray-900 text-sm"><%= c.CATEGORY_NAME %></td>
                        <td class="p-3">
                            <% if (c.PARENT_CATEGORY_ID) { %>
                                <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-blue-100 text-blue-700">Cấp 2 (Con)</span>
                            <% } else { %>
                                <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-gray-200 text-gray-800">Cấp 1 (Gốc)</span>
                            <% } %>
                        </td>
                        <!-- YÊU CẦU 1: Hiển thị văn bản bình thường, không được in chuỗi HTML thô -->
                        <td class="p-3">
                            <% if (c.PARENT_NAME) { %>
                                <span class="text-gray-900 font-medium"><%= c.PARENT_NAME %></span>
                            <% } else { %>
                                <span class="text-gray-400 italic">Không có (Danh mục gốc)</span>
                            <% } %>
                        </td>
                        <!-- NÚT SỬA & XÓA ĐẦY ĐỦ -->
                        <td class="p-3 text-right space-x-1">
                            <button onclick="openEditCategoryModal(<%= c.CATEGORY_ID %>, '<%= c.CATEGORY_NAME.replace(/'/g, "\\'") %>', '<%= c.IMAGE_URL || '' %>', '<%= c.PARENT_CATEGORY_ID || '' %>')" class="px-2.5 py-1 bg-amber-500 hover:bg-amber-600 text-white rounded text-[11px] font-semibold shadow-xs">
                                <i class="fa-solid fa-pen-to-square mr-1"></i> Sửa
                            </button>
                            <form action="/admin/categories/delete" method="POST" class="inline-block" onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục này? Hệ thống sẽ kiểm tra ràng buộc sản phẩm trước khi xóa.')">
                                <input type="hidden" name="categoryId" value="<%= c.CATEGORY_ID %>">
                                <button type="submit" class="px-2.5 py-1 bg-red-600 hover:bg-red-700 text-white rounded text-[11px] font-semibold shadow-xs">
                                    <i class="fa-solid fa-trash mr-1"></i> Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm Danh Mục Mới -->
<div id="modalCreateCategory" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 relative">
        <button onclick="document.getElementById('modalCreateCategory').classList.add('hidden')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
            <i class="fa-solid fa-layer-group text-orange-600 mr-2"></i> Thêm Danh Mục Sản Phẩm
        </h3>

        <form action="/admin/categories/create" method="POST" class="space-y-3.5 text-xs">
            <div>
                <label class="block font-semibold text-gray-700 mb-1">Tên Danh Mục *</label>
                <input type="text" name="categoryName" placeholder="VD: Bánh kẹo & Ăn vặt" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
            </div>

            <div>
                <label class="block font-semibold text-gray-700 mb-1">URL Hình Ảnh</label>
                <input type="url" name="imageUrl" placeholder="https://..." class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
            </div>

            <div>
                <label class="block font-semibold text-gray-700 mb-1">Danh Mục Cha (Nếu là danh mục con)</label>
                <select name="parentCategoryId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
                    <option value="">-- Là danh mục gốc (Cấp 1) --</option>
                    <% categories.filter(c => !c.PARENT_CATEGORY_ID).forEach(c => { %>
                        <option value="<%= c.CATEGORY_ID %>"><%= c.CATEGORY_NAME %></option>
                    <% }) %>
                </select>
            </div>

            <div>
                <label class="block font-semibold text-gray-700 mb-1">Gán Ngay Cho Gian Hàng Nào Kinh Doanh (SELLS_CATEGORIES)</label>
                <select name="shopId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
                    <option value="">-- Chưa gán ngay --</option>
                    <% shops.forEach(s => { %>
                        <option value="<%= s.SHOP_ID %>"><%= s.SHOP_NAME %></option>
                    <% }) %>
                </select>
            </div>

            <div class="pt-4 flex justify-end space-x-2">
                <button type="button" onclick="document.getElementById('modalCreateCategory').classList.add('hidden')" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg font-semibold">Hủy</button>
                <button type="submit" class="px-4 py-2 bg-orange-600 hover:bg-orange-700 text-white rounded-lg font-semibold">Tạo Danh Mục</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Sửa Danh Mục (Yêu cầu 3) -->
<div id="modalEditCategory" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 relative">
        <button onclick="document.getElementById('modalEditCategory').classList.add('hidden')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
            <i class="fa-solid fa-pen-to-square text-amber-600 mr-2"></i> Chỉnh Sửa Danh Mục
        </h3>

        <form action="/admin/categories/update" method="POST" class="space-y-3.5 text-xs">
            <input type="hidden" id="editCatId" name="categoryId">

            <div>
                <label class="block font-semibold text-gray-700 mb-1">Tên Danh Mục *</label>
                <input type="text" id="editCatName" name="categoryName" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
            </div>

            <div>
                <label class="block font-semibold text-gray-700 mb-1">URL Hình Ảnh</label>
                <input type="url" id="editCatImage" name="imageUrl" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
            </div>

            <div>
                <label class="block font-semibold text-gray-700 mb-1">Danh Mục Cha (Parent)</label>
                <select id="editCatParent" name="parentCategoryId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
                    <option value="">-- Là danh mục gốc (Cấp 1) --</option>
                    <% categories.forEach(c => { %>
                        <option value="<%= c.CATEGORY_ID %>"><%= c.CATEGORY_NAME %></option>
                    <% }) %>
                </select>
            </div>

            <div class="pt-4 flex justify-end space-x-2">
                <button type="button" onclick="document.getElementById('modalEditCategory').classList.add('hidden')" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg font-semibold">Hủy</button>
                <button type="submit" class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg font-semibold">Lưu Cập Nhật</button>
            </div>
        </form>
    </div>
</div>

<script>
function openEditCategoryModal(id, name, img, parentId) {
    document.getElementById('editCatId').value = id;
    document.getElementById('editCatName').value = name;
    document.getElementById('editCatImage').value = img;
    document.getElementById('editCatParent').value = parentId || '';
    document.getElementById('modalEditCategory').classList.remove('hidden');
}
</script>

<%- include('admin-layout-bottom') %>

<script>
function filterTableRows(tableId, query) {
    query = (query || '').toLowerCase().trim();
    const table = document.getElementById(tableId);
    if (!table) return;
    const rows = table.querySelectorAll('tbody tr');
    let visibleCount = 0;
    rows.forEach(r => {
        const text = r.innerText.toLowerCase();
        if (text.includes(query)) {
            r.style.display = '';
            visibleCount++;
        } else {
            r.style.display = 'none';
        }
    });
    const countEl = document.getElementById('filterCount_' + tableId);
    if (countEl) {
        countEl.innerText = query ? ('Hiển thị: ' + visibleCount + '/' + rows.length) : '';
    }
}

function clearTableFilter(tableId) {
    const input = document.getElementById('filterInput_' + tableId);
    if (input) input.value = '';
    filterTableRows(tableId, '');
}
</script>
