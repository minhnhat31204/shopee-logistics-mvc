<%- include('admin-layout-top') %>

<div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-3">
    <div>
        <h2 class="text-xl font-bold text-gray-900">Quản Lý Vị Trí Kệ Hàng (Aisle - Rack - Shelf - Bin)</h2>
        <p class="text-xs text-gray-500">Mô hình phân chia vị trí ô kệ kho chuẩn. Quy tắc: Không cho xóa vị trí đang có hàng tồn kho; Phải xóa/chuyển hàng trước.</p>
    </div>
    <div class="flex items-center space-x-2">
        <button onclick="document.getElementById('modalCreateLocation').classList.remove('hidden')" class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-bold shadow flex items-center">
            <i class="fa-solid fa-plus mr-1.5"></i> Tạo Vị Trí Kệ Mới
        </button>
        <a href="/admin/warehouses" class="px-3.5 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-xs font-bold shadow-sm flex items-center">
            <i class="fa-solid fa-warehouse mr-1.5"></i> Về Quản Lý Kho
        </a>
    </div>
</div>

<% if (msg) { %>
    <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-700 rounded-lg text-sm flex items-center">
        <i class="fa-solid fa-circle-check mr-2"></i> <%= msg %>
    </div>
<% } %>

<% if (err) { %>
    <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm flex items-center">
        <i class="fa-solid fa-triangle-exclamation mr-2 text-lg text-red-600"></i>
        <div class="font-semibold text-sm"><%= err %></div>
    </div>
<% } %>

<!-- Bảng Danh Sách Vị Trí Kệ -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-6">
    <div class="p-3 bg-gray-50 border-b border-gray-100 flex items-center justify-between gap-3">
        <div class="relative flex-1 max-w-md">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-gray-400 text-xs"></i>
            <input type="text" id="filterInput_locationsTable" onkeyup="filterTableRows('locationsTable', this.value)" placeholder="Tìm theo mã vị trí, kho, dãy, kệ..." class="w-full pl-8 pr-8 py-1.5 text-xs bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 shadow-sm">
            <button type="button" onclick="clearTableFilter('locationsTable')" title="Xóa từ khóa & Làm mới" class="absolute right-2.5 top-2 text-gray-400 hover:text-red-600 text-xs">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="flex items-center space-x-2">
            <span id="filterCount_locationsTable" class="text-[11px] text-gray-400"></span>
            <button type="button" onclick="clearTableFilter('locationsTable')" class="px-3 py-1.5 bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 rounded-lg text-xs font-semibold shadow-sm flex items-center">
                <i class="fa-solid fa-arrows-rotate mr-1"></i> Làm mới
            </button>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table id="locationsTable" class="w-full text-left text-xs text-gray-600">
            <thead class="bg-gray-50 text-gray-500 uppercase tracking-wider text-[11px]">
                <tr>
                    <th class="p-3">Kho Chứa</th>
                    <th class="p-3">Mã Vị Trí Kệ</th>
                    <th class="p-3">Dãy (Aisle)</th>
                    <th class="p-3">Kệ (Rack)</th>
                    <th class="p-3">Tầng (Shelf)</th>
                    <th class="p-3">Ô (Bin)</th>
                    <th class="p-3">Tồn Kho Hiện Tại</th>
                    <th class="p-3 text-right">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <% if (locations.length === 0) { %>
                    <tr>
                        <td colspan="8" class="p-6 text-center text-gray-400 italic">Chưa có vị trí kệ nào được tạo.</td>
                    </tr>
                <% } %>
                <% locations.forEach(l => { %>
                    <tr class="hover:bg-gray-50">
                        <td class="p-3 font-bold text-gray-800">
                            <i class="fa-solid fa-warehouse mr-1 text-gray-400"></i><%= l.WAREHOUSE_NAME %>
                        </td>
                        <td class="p-3 font-mono font-bold text-indigo-700 text-sm">
                            <i class="fa-solid fa-location-dot mr-1"></i><%= l.LOCATION_CODE %>
                        </td>
                        <td class="p-3 font-mono font-bold text-gray-700">Dãy <%= l.AISLE %></td>
                        <td class="p-3 font-mono text-gray-700">Kệ <%= l.RACK %></td>
                        <td class="p-3 font-mono text-gray-700">Tầng <%= l.SHELF %></td>
                        <td class="p-3 font-mono text-gray-700">Ô <%= l.BIN %></td>
                        <td class="p-3">
                            <% if (Number(l.TOTAL_STOCK || 0) > 0) { %>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                                    Đang chứa <%= Number(l.TOTAL_STOCK).toLocaleString('vi-VN') %> sp (<%= l.BATCH_COUNT %> lô)
                                </span>
                            <% } else { %>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-gray-100 text-gray-500">
                                    Kệ trống (0 sp)
                                </span>
                            <% } %>
                        </td>
                        <td class="p-3 text-right space-x-1 whitespace-nowrap">
                            <button onclick="openEditLocationModal(<%= l.WAREHOUSE_ID %>, '<%= l.AISLE %>', '<%= l.RACK %>', '<%= l.SHELF %>', '<%= l.BIN %>')" class="px-2.5 py-1 bg-amber-500 hover:bg-amber-600 text-white rounded text-[11px] font-semibold">
                                <i class="fa-solid fa-pen-to-square mr-1"></i> Sửa
                            </button>
                            <form action="/admin/locations/delete" method="POST" class="inline-block" onsubmit="return confirm('Bạn có chắc chắn muốn xóa vị trí kệ [<%= l.LOCATION_CODE %>]? Hệ thống sẽ từ chối nếu vị trí đang có hàng tồn kho.')">
                                <input type="hidden" name="redirectUrl" value="/admin/locations">
                                <input type="hidden" name="warehouseId" value="<%= l.WAREHOUSE_ID %>">
                                <input type="hidden" name="aisle" value="<%= l.AISLE %>">
                                <input type="hidden" name="rack" value="<%= l.RACK %>">
                                <input type="hidden" name="shelf" value="<%= l.SHELF %>">
                                <input type="hidden" name="bin" value="<%= l.BIN %>">
                                <button type="submit" class="px-2.5 py-1 bg-red-600 hover:bg-red-700 text-white rounded text-[11px] font-semibold">
                                    <i class="fa-solid fa-trash mr-1"></i> Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Tạo Vị Trí Kệ Mới -->
<div id="modalCreateLocation" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 relative">
        <button onclick="document.getElementById('modalCreateLocation').classList.add('hidden')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-base font-bold text-gray-900 mb-3 flex items-center">
            <i class="fa-solid fa-location-dot text-indigo-600 mr-2"></i> Tạo Vị Trí Kệ Kho Mới
        </h3>
        <form action="/admin/locations/create" method="POST" class="space-y-3.5 text-xs">
            <input type="hidden" name="redirectUrl" value="/admin/locations">
            <div>
                <label class="block font-semibold text-gray-700 mb-1">Kho Chứa *</label>
                <select name="warehouseId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 bg-white">
                    <% warehouses.forEach(w => { %>
                        <option value="<%= w.WAREHOUSE_ID %>"><%= w.WAREHOUSE_NAME %></option>
                    <% }) %>
                </select>
            </div>
            <div class="grid grid-cols-4 gap-2">
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Dãy (Aisle)</label>
                    <input type="text" name="aisle" placeholder="A" required class="w-full px-2 py-1.5 border border-gray-300 rounded-lg text-center font-mono uppercase">
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Kệ (Rack)</label>
                    <input type="text" name="rack" placeholder="01" required class="w-full px-2 py-1.5 border border-gray-300 rounded-lg text-center font-mono uppercase">
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Tầng (Shelf)</label>
                    <input type="text" name="shelf" placeholder="01" required class="w-full px-2 py-1.5 border border-gray-300 rounded-lg text-center font-mono uppercase">
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Ô (Bin)</label>
                    <input type="text" name="bin" placeholder="01" required class="w-full px-2 py-1.5 border border-gray-300 rounded-lg text-center font-mono uppercase">
                </div>
            </div>
            <div class="pt-2 flex justify-end space-x-2">
                <button type="button" onclick="document.getElementById('modalCreateLocation').classList.add('hidden')" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-semibold">Hủy</button>
                <button type="submit" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-bold shadow">Tạo Vị Trí Kệ</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Sửa Vị Trí Kệ -->
<div id="modalEditLocation" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 relative">
        <button onclick="document.getElementById('modalEditLocation').classList.add('hidden')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-base font-bold text-gray-900 mb-3 flex items-center">
            <i class="fa-solid fa-pen-to-square text-amber-600 mr-2"></i> Chỉnh Sửa Định Vị Kệ
        </h3>
        <p class="text-[11px] text-gray-500 mb-3">Nếu vị trí này đang có hàng tồn kho, hệ thống sẽ tự động cập nhật vị trí mới cho các lô hàng đó.</p>

        <form action="/admin/locations/update" method="POST" class="space-y-3.5 text-xs">
            <input type="hidden" name="redirectUrl" value="/admin/locations">
            <input type="hidden" id="editLocWhId" name="warehouseId">
            <input type="hidden" id="editLocOldAisle" name="oldAisle">
            <input type="hidden" id="editLocOldRack" name="oldRack">
            <input type="hidden" id="editLocOldShelf" name="oldShelf">
            <input type="hidden" id="editLocOldBin" name="oldBin">

            <div class="p-2.5 bg-gray-50 rounded border border-gray-200 text-[11px]">
                Vị trí ban đầu: <strong id="editLocOldKey" class="text-indigo-700 font-mono"></strong>
            </div>

            <div class="grid grid-cols-4 gap-2">
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Dãy mới</label>
                    <input type="text" id="editLocNewAisle" name="newAisle" required class="w-full px-2 py-1.5 border border-gray-300 rounded-lg text-center font-mono uppercase">
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Kệ mới</label>
                    <input type="text" id="editLocNewRack" name="newRack" required class="w-full px-2 py-1.5 border border-gray-300 rounded-lg text-center font-mono uppercase">
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Tầng mới</label>
                    <input type="text" id="editLocNewShelf" name="newShelf" required class="w-full px-2 py-1.5 border border-gray-300 rounded-lg text-center font-mono uppercase">
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Ô mới</label>
                    <input type="text" id="editLocNewBin" name="newBin" required class="w-full px-2 py-1.5 border border-gray-300 rounded-lg text-center font-mono uppercase">
                </div>
            </div>
            <div class="pt-2 flex justify-end space-x-2">
                <button type="button" onclick="document.getElementById('modalEditLocation').classList.add('hidden')" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-semibold">Hủy</button>
                <button type="submit" class="px-5 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg font-bold shadow">Lưu Vị Trí Mới</button>
            </div>
        </form>
    </div>
</div>

<%- include('admin-layout-bottom') %>

<script>
function filterTableRows(tableId, query) {
    query = (query || '').toLowerCase().trim();
    const table = document.getElementById(tableId);
    if (!table) return;
    const rows = table.querySelectorAll('tbody tr');
    let visibleCount = 0;
    rows.forEach(r => {
        const text = r.innerText.toLowerCase();
        if (text.includes(query)) {
            r.style.display = '';
            visibleCount++;
        } else {
            r.style.display = 'none';
        }
    });
    const countEl = document.getElementById('filterCount_' + tableId);
    if (countEl) {
        countEl.innerText = query ? ('Hiển thị: ' + visibleCount + '/' + rows.length) : '';
    }
}

function clearTableFilter(tableId) {
    const input = document.getElementById('filterInput_' + tableId);
    if (input) input.value = '';
    filterTableRows(tableId, '');
}

function openEditLocationModal(whId, a, r, s, b) {
    document.getElementById('editLocWhId').value = whId;
    document.getElementById('editLocOldAisle').value = a;
    document.getElementById('editLocOldRack').value = r;
    document.getElementById('editLocOldShelf').value = s;
    document.getElementById('editLocOldBin').value = b;

    document.getElementById('editLocOldKey').innerText = a + '-' + r + '-' + s + '-' + b;

    document.getElementById('editLocNewAisle').value = a;
    document.getElementById('editLocNewRack').value = r;
    document.getElementById('editLocNewShelf').value = s;
    document.getElementById('editLocNewBin').value = b;

    document.getElementById('modalEditLocation').classList.remove('hidden');
}

window.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const filterWhId = urlParams.get('whId');
    if (filterWhId) {
        const input = document.getElementById('filterInput_locationsTable');
        if (input) {
            input.value = filterWhId;
            filterTableRows('locationsTable', filterWhId);
        }
    }
});
</script>