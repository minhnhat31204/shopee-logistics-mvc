<%- include('admin-layout-top') %>

<div class="flex justify-between items-center mb-6">
    <div>
        <h2 class="text-xl font-bold text-gray-900">Quản Lý Người Dùng & Phân Quyền</h2>
        <p class="text-xs text-gray-500">Khởi tạo tài khoản, chỉnh sửa thông tin, phân quyền Role và xóa an toàn theo logic CSDL.</p>
    </div>
    <button onclick="document.getElementById('modalCreateUser').classList.remove('hidden')" class="px-4 py-2 bg-orange-600 hover:bg-orange-700 text-white rounded-lg text-sm font-semibold shadow flex items-center">
        <i class="fa-solid fa-user-plus mr-2"></i> Thêm Người Dùng Mới
    </button>
</div>

<% if (msg) { %>
    <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-700 rounded-lg text-sm flex items-center">
        <i class="fa-solid fa-circle-check mr-2"></i> <%= msg %>
    </div>
<% } %>

<% if (err) { %>
    <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm flex items-center">
        <i class="fa-solid fa-circle-exclamation mr-2"></i> <%= err %>
    </div>
<% } %>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    
<!-- Thanh Tìm Kiếm Nhanh & Làm Mới (Yêu cầu 6) -->
<div class="p-3 bg-gray-50 border-b border-gray-100 flex items-center justify-between gap-3">
    <div class="relative flex-1 max-w-md">
        <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-gray-400 text-xs"></i>
        <input type="text" id="filterInput_adminUsersTable" onkeyup="filterTableRows('adminUsersTable', this.value)" placeholder="Tìm theo họ tên, username, email, số điện thoại, vai trò..." class="w-full pl-8 pr-8 py-1.5 text-xs bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-orange-500 shadow-sm">
        <button type="button" onclick="clearTableFilter('adminUsersTable')" title="Xóa từ khóa & Làm mới" class="absolute right-2.5 top-2 text-gray-400 hover:text-red-600 text-xs">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
    <div class="flex items-center space-x-2">
        <span id="filterCount_adminUsersTable" class="text-[11px] text-gray-400"></span>
        <button type="button" onclick="clearTableFilter('adminUsersTable')" class="px-3 py-1.5 bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 rounded-lg text-xs font-semibold shadow-sm flex items-center">
            <i class="fa-solid fa-arrows-rotate mr-1"></i> Làm mới
        </button>
    </div>
</div>

<div class="overflow-x-auto">
        <table id="adminUsersTable" class="w-full text-left text-xs text-gray-600">
            <thead class="bg-gray-50 text-gray-500 uppercase tracking-wider text-[11px]">
                <tr>
                    <th class="p-3">ID</th>
                    <th class="p-3">Người Dùng</th>
                    <th class="p-3">Email & SĐT</th>
                    <th class="p-3">Vai Trò (Role)</th>
                    <th class="p-3">Kho Quản Lý</th>
                    <th class="p-3">Ngày Tạo</th>
                    <th class="p-3 text-right">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <% users.forEach(u => { %>
                    <tr class="hover:bg-gray-50">
                        <td class="p-3 font-mono font-bold text-gray-500">#<%= u.USER_ID %></td>
                        <td class="p-3">
                            <div class="flex items-center space-x-3">
                                <img src="<%= u.AVATAR || '/images/default-avatar.png' %>" class="w-8 h-8 rounded-full border border-gray-200 object-cover">
                                <div>
                                    <div class="font-bold text-gray-900"><%= u.FULL_NAME %></div>
                                    <div class="text-[10px] text-gray-400 font-mono">@<%= u.USERNAME %></div>
                                </div>
                            </div>
                        </td>
                        <td class="p-3">
                            <div><i class="fa-regular fa-envelope mr-1 text-gray-400"></i><%= u.EMAIL %></div>
                            <div class="text-[10px] text-gray-400 mt-0.5"><i class="fa-solid fa-phone mr-1"></i><%= u.PHONE || '-' %></div>
                        </td>
                        <td class="p-3">
                            <% if (u.ROLE_NAME === 'ADMIN') { %>
                                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-blue-100 text-blue-700">ADMIN</span>
                            <% } else if (u.ROLE_NAME === 'SHOPKEEPER') { %>
                                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-purple-100 text-purple-700">SHOPKEEPER</span>
                            <% } else { %>
                                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700">CUSTOMER</span>
                            <% } %>
                        </td>
                        <td class="p-3">
                            <% if (u.WAREHOUSE_NAME) { %>
                                <span class="px-2 py-0.5 bg-gray-100 text-gray-700 rounded text-[11px] font-medium">
                                    <i class="fa-solid fa-warehouse mr-1 text-gray-400"></i><%= u.WAREHOUSE_NAME %>
                                </span>
                            <% } else { %>
                                <span class="text-gray-400 italic">Không phân bổ</span>
                            <% } %>
                        </td>
                        <td class="p-3 text-gray-400"><%= u.CREATED_AT %></td>
                        <!-- NÚT SỬA & XÓA ĐẦY ĐỦ (Yêu cầu 2 & 3) -->
                        <td class="p-3 text-right space-x-1 whitespace-nowrap">
                            <button onclick="openEditUserModal(<%= u.USER_ID %>, '<%= u.FULL_NAME.replace(/'/g, "\\'") %>', '<%= u.EMAIL %>', '<%= u.PHONE || '' %>', <%= u.ROLE_ID %>, '<%= u.WAREHOUSE_ID || '' %>')" class="px-2.5 py-1 bg-amber-500 hover:bg-amber-600 text-white rounded text-[11px] font-semibold">
                                <i class="fa-solid fa-pen-to-square mr-1"></i> Sửa
                            </button>
                            <% if (u.ROLE_NAME === 'ADMIN' || u.ROLE_ID === 1) { %>
                                <span class="inline-flex items-center px-2 py-1 bg-gray-100 text-gray-400 rounded text-[11px] font-medium cursor-not-allowed border border-gray-200" title="Không thể xóa tài khoản Quản trị viên (Admin)">
                                    <i class="fa-solid fa-shield-halved mr-1 text-gray-400"></i> Admin cố định
                                </span>
                            <% } else { %>
                                <form action="/admin/users/delete" method="POST" class="inline-block" onsubmit="return confirm('Bạn có chắc chắn muốn xóa người dùng này? Hệ thống sẽ kiểm tra đơn hàng và cửa hàng trước khi xóa.')">
                                    <input type="hidden" name="userId" value="<%= u.USER_ID %>">
                                    <button type="submit" class="px-2.5 py-1 bg-red-600 hover:bg-red-700 text-white rounded text-[11px] font-semibold">
                                        <i class="fa-solid fa-trash mr-1"></i> Xóa
                                    </button>
                                </form>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm Người Dùng Mới -->
<div id="modalCreateUser" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-lg w-full p-6 relative">
        <button onclick="document.getElementById('modalCreateUser').classList.add('hidden')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
            <i class="fa-solid fa-user-plus text-orange-600 mr-2"></i> Khởi Tạo Người Dùng Mới
        </h3>

        <form action="/admin/users/create" method="POST" class="space-y-3.5 text-xs">
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Email (@gmail.com) *</label>
                    <input type="email" name="email" required placeholder="user@gmail.com" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Mật khẩu ban đầu *</label>
                    <input type="password" name="password" required value="123456" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Họ và Tên *</label>
                    <input type="text" name="fullName" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Số điện thoại</label>
                    <input type="text" name="phone" placeholder="0901234567" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Phân quyền (Role) *</label>
                    <select name="roleId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
                        <% roles.forEach(r => { %>
                            <option value="<%= r.ROLE_ID %>"><%= r.ROLE_NAME %> - <%= r.DESCRIPTION %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Kho trực thuộc (cho Admin kho)</label>
                    <select name="warehouseId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
                        <option value="">-- Không trực thuộc kho --</option>
                        <% warehouses.forEach(w => { %>
                            <option value="<%= w.WAREHOUSE_ID %>"><%= w.WAREHOUSE_NAME %></option>
                        <% }) %>
                    </select>
                </div>
            </div>

            <div class="pt-4 flex justify-end space-x-2">
                <button type="button" onclick="document.getElementById('modalCreateUser').classList.add('hidden')" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg font-semibold">Hủy</button>
                <button type="submit" class="px-4 py-2 bg-orange-600 hover:bg-orange-700 text-white rounded-lg font-semibold">Tạo Người Dùng</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Sửa Người Dùng & Phân Quyền (Yêu cầu 3) -->
<div id="modalEditUser" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-lg w-full p-6 relative">
        <button onclick="document.getElementById('modalEditUser').classList.add('hidden')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
            <i class="fa-solid fa-user-pen text-amber-600 mr-2"></i> Chỉnh Sửa Thông Tin & Quyền Người Dùng
        </h3>

        <form action="/admin/users/update-role" method="POST" class="space-y-3.5 text-xs">
            <input type="hidden" id="editUserId" name="userId">

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Họ và Tên *</label>
                    <input type="text" id="editFullName" name="fullName" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Email *</label>
                    <input type="email" id="editEmail" name="email" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
                </div>
            </div>

            <div>
                <label class="block font-semibold text-gray-700 mb-1">Số Điện Thoại</label>
                <input type="text" id="editPhone" name="phone" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Vai Trò (Role) *</label>
                    <select id="editRoleId" name="roleId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
                        <% roles.forEach(r => { %>
                            <option value="<%= r.ROLE_ID %>"><%= r.ROLE_NAME %> - <%= r.DESCRIPTION %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Kho Quản Lý</label>
                    <select id="editWarehouseId" name="warehouseId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none">
                        <option value="">-- Không trực thuộc kho --</option>
                        <% warehouses.forEach(w => { %>
                            <option value="<%= w.WAREHOUSE_ID %>"><%= w.WAREHOUSE_NAME %></option>
                        <% }) %>
                    </select>
                </div>
            </div>

            <div class="pt-4 flex justify-end space-x-2">
                <button type="button" onclick="document.getElementById('modalEditUser').classList.add('hidden')" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg font-semibold">Hủy</button>
                <button type="submit" class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg font-semibold">Lưu Thay Đổi</button>
            </div>
        </form>
    </div>
</div>

<script>
function openEditUserModal(id, name, email, phone, roleId, whId) {
    document.getElementById('editUserId').value = id;
    document.getElementById('editFullName').value = name;
    document.getElementById('editEmail').value = email;
    document.getElementById('editPhone').value = phone || '';
    document.getElementById('editRoleId').value = roleId;
    document.getElementById('editWarehouseId').value = whId || '';
    document.getElementById('modalEditUser').classList.remove('hidden');
}
</script>

<%- include('admin-layout-bottom') %>

<script>
function filterTableRows(tableId, query) {
    query = (query || '').toLowerCase().trim();
    const table = document.getElementById(tableId);
    if (!table) return;
    const rows = table.querySelectorAll('tbody tr');
    let visibleCount = 0;
    rows.forEach(r => {
        const text = r.innerText.toLowerCase();
        if (text.includes(query)) {
            r.style.display = '';
            visibleCount++;
        } else {
            r.style.display = 'none';
        }
    });
    const countEl = document.getElementById('filterCount_' + tableId);
    if (countEl) {
        countEl.innerText = query ? ('Hiển thị: ' + visibleCount + '/' + rows.length) : '';
    }
}

function clearTableFilter(tableId) {
    const input = document.getElementById('filterInput_' + tableId);
    if (input) input.value = '';
    filterTableRows(tableId, '');
}
</script>
