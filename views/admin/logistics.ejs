            <input type="hidden" id="editInvAisle" name="aisle">
            <input type="hidden" id="editInvRack" name="rack">
            <input type="hidden" id="editInvShelf" name="shelf">
            <input type="hidden" id="editInvBin" name="bin">
            <input type="hidden" id="editInvProdId" name="productId">
            <input type="hidden" id="editInvSku" name="sku">
            <input type="hidden" id="editInvBatch" name="batchNumber">

            <div class="p-3 bg-amber-50/70 rounded-lg border border-amber-200/80 space-y-1">
                <div>Sản phẩm: <strong id="editInvProdName" class="text-gray-900"></strong></div>
                <div>Kho & Vị trí kệ: <strong id="editInvWhName" class="text-gray-800"></strong> (<span id="editInvLocationCode" class="font-mono text-indigo-700 font-bold"></span>)</div>
                <div>Mã SKU: <strong id="editInvDisplaySku" class="font-mono text-indigo-800"></strong> | Lô: <strong id="editInvDisplayBatch" class="font-mono text-gray-800"></strong></div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Số Lượng Tồn Kho *</label>
                    <input type="number" id="editInvQuantity" name="quantity" min="0" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-amber-500 font-bold text-sm">
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Mức Tồn Tối Thiểu *</label>
                    <input type="number" id="editInvMinStock" name="minStockLevel" min="0" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-amber-500 font-bold text-sm">
                </div>
            </div>

            <div>
                <label class="block font-semibold text-gray-700 mb-1">Hạn Sử Dụng Lô Hàng (Expiry Date)</label>
                <input type="date" id="editInvExpiry" name="expiryDate" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-amber-500">
                <p class="text-[10px] text-gray-400 mt-1">Đổi ngày hết hạn sẽ đồng bộ vào thông tin lô hàng nhập kho của sản phẩm này.</p>
            </div>

            <div class="pt-2 flex justify-end space-x-2">
                <button type="button" onclick="document.getElementById('modalEditInventory').classList.add('hidden')" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-semibold">Hủy</button>
                <button type="submit" class="px-5 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg font-bold shadow">Lưu Cập Nhật</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal 2: Điều Chuyển Vị Trí Hàng Tồn Kho (Move Inventory) -->
<div id="modalMoveInventory" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 relative">
        <button onclick="document.getElementById('modalMoveInventory').classList.add('hidden')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-base font-bold text-gray-900 mb-3 flex items-center">
            <i class="fa-solid fa-arrows-up-down-left-right text-indigo-600 mr-2"></i> Điều Chuyển Vị Trí Hàng Tồn Kho
        </h3>

        <form action="/admin/inventory/move" method="POST" class="space-y-3.5 text-xs">
            <input type="hidden" id="moveWhId" name="warehouseId">
            <input type="hidden" id="moveFromAisle" name="fromAisle">
            <input type="hidden" id="moveFromRack" name="fromRack">
            <input type="hidden" id="moveFromShelf" name="fromShelf">
            <input type="hidden" id="moveFromBin" name="fromBin">
            <input type="hidden" id="moveProdId" name="productId">
            <input type="hidden" id="moveSku" name="sku">
