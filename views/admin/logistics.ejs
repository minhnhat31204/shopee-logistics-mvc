</div>

<script>
function handleOpenAdminEditReceiptModal(btn) {
    const receiptId = btn.getAttribute('data-receipt-id');
    const warehouseId = btn.getAttribute('data-warehouse-id');
    const status = btn.getAttribute('data-status');
    const quantity = btn.getAttribute('data-quantity');

    document.getElementById('adminEditReceiptIdText').innerText = receiptId;
    document.getElementById('adminEditReceiptId').value = receiptId;
    document.getElementById('adminEditWarehouseId').value = warehouseId || '1';
    document.getElementById('adminEditReceiptStatus').value = status || 'PENDING';
    document.getElementById('adminEditReceiptQuantity').value = quantity || '';
    document.getElementById('modalAdminEditReceipt').classList.remove('hidden');
}

function closeAdminEditReceiptModal() {
    document.getElementById('modalAdminEditReceipt').classList.add('hidden');
}

const allLocationsData = <%- JSON.stringify(typeof locations !== 'undefined' ? locations : []) %>;

function onInboundWarehouseChanged(whId) {
    const locSelect = document.getElementById('inboundLocationSelect');
    if (!locSelect) return;
    locSelect.innerHTML = '';
    const filtered = allLocationsData.filter(l => Number(l.WAREHOUSE_ID) === Number(whId));
    if (filtered.length > 0) {
        filtered.forEach(l => {
            const opt = document.createElement('option');
            opt.value = l.AISLE + '-' + l.RACK + '-' + l.SHELF + '-' + l.BIN;
            opt.textContent = 'Dãy ' + l.AISLE + ' | Kệ ' + l.RACK + ' | Tầng ' + l.SHELF + ' | Ô ' + l.BIN;
            locSelect.appendChild(opt);
        });
    } else {
        const opt = document.createElement('option');
        opt.value = '';
        opt.textContent = '-- Kho này chưa có vị trí kệ nào --';
        locSelect.appendChild(opt);
    }
}

function openEditInventoryModal(whId, a, r, s, b, prodId, sku, batch, qty, minStock, expiry, prodName, whName) {
    document.getElementById('editInvWhId').value = whId;
    document.getElementById('editInvAisle').value = a;
    document.getElementById('editInvRack').value = r;
    document.getElementById('editInvShelf').value = s;
    document.getElementById('editInvBin').value = b;
    document.getElementById('editInvProdId').value = prodId;
    document.getElementById('editInvSku').value = sku;
    document.getElementById('editInvBatch').value = batch;

    document.getElementById('editInvProdName').innerText = prodName;
    document.getElementById('editInvWhName').innerText = whName;
    document.getElementById('editInvLocationCode').innerText = a + '-' + r + '-' + s + '-' + b;
    document.getElementById('editInvDisplaySku').innerText = sku;
    document.getElementById('editInvDisplayBatch').innerText = batch;

    document.getElementById('editInvQuantity').value = qty;
    document.getElementById('editInvMinStock').value = minStock;
    document.getElementById('editInvExpiry').value = expiry ? expiry.substring(0, 10) : '';

    document.getElementById('modalEditInventory').classList.remove('hidden');
}

function openMoveInventoryModal(whId, a, r, s, b, prodId, sku, batch, qty) {
    document.getElementById('moveWhId').value = whId;
    document.getElementById('moveFromAisle').value = a;
    document.getElementById('moveFromRack').value = r;
    document.getElementById('moveFromShelf').value = s;
    document.getElementById('moveFromBin').value = b;
    document.getElementById('moveProdId').value = prodId;
    document.getElementById('moveSku').value = sku;
    document.getElementById('moveBatchNumber').value = batch;

    document.getElementById('moveDisplaySku').innerText = sku;
    document.getElementById('moveDisplayBatch').innerText = batch;
    document.getElementById('moveDisplayQty').innerText = qty;
    document.getElementById('moveDisplayFrom').innerText = a + '-' + r + '-' + s + '-' + b;

    document.getElementById('modalMoveInventory').classList.remove('hidden');
}

// ==================== BỘ LỌC TỒN KHO & TÌM KIẾM & CẬN HẠN TỰ DO ====================
function onExpiryPresetChanged(val) {
    const customWrapper = document.getElementById('customDaysWrapper');
    if (val === 'custom') {
        customWrapper.classList.remove('hidden');
    } else {
        customWrapper.classList.add('hidden');
    }
    applyInventoryFilters();
}

function clearInventorySearch() {
    const input = document.getElementById('inventorySearchInput');
    if (input) {
        input.value = '';
        applyInventoryFilters();
    }
}

function resetAllInventoryFilters() {
    const searchInput = document.getElementById('inventorySearchInput');
    const presetSelect = document.getElementById('filterExpiryPreset');
    const customDaysInput = document.getElementById('customDaysInput');
    const whSelect = document.getElementById('filterWarehouse');
    const statusSelect = document.getElementById('filterStockStatus');
    const customWrapper = document.getElementById('customDaysWrapper');

    if (searchInput) searchInput.value = '';
    if (presetSelect) presetSelect.value = 'all';
    if (customDaysInput) customDaysInput.value = '30';
    if (whSelect) whSelect.value = '';
    if (statusSelect) statusSelect.value = '';
    if (customWrapper) customWrapper.classList.add('hidden');

    applyInventoryFilters();
}

function applyInventoryFilters() {
    const query = (document.getElementById('inventorySearchInput')?.value || '').toLowerCase().trim();
    const expiryPreset = document.getElementById('filterExpiryPreset')?.value || 'all';
    const customDaysVal = parseInt(document.getElementById('customDaysInput')?.value, 10);
    const selectedWh = (document.getElementById('filterWarehouse')?.value || '').toLowerCase().trim();
    const selectedStatus = document.getElementById('filterStockStatus')?.value || '';

    const rows = document.querySelectorAll('#inventoryTable tbody tr.inventory-row');
    let visibleCount = 0;

    rows.forEach(r => {
        const text = r.innerText.toLowerCase();
        const daysLeft = parseFloat(r.getAttribute('data-days-left'));
        const rowWh = r.getAttribute('data-warehouse') || '';
        const rowStatus = r.getAttribute('data-status') || '';

        // 1. Kiểm tra từ khóa tìm kiếm
        let matchQuery = !query || text.includes(query);

        // 2. Kiểm tra bộ lọc cận hạn
        let matchExpiry = true;
        if (expiryPreset === 'expired') {
            matchExpiry = (daysLeft <= 0);
        } else if (expiryPreset === '7') {
            matchExpiry = (daysLeft <= 7);
        } else if (expiryPreset === '15') {
            matchExpiry = (daysLeft <= 15);
        } else if (expiryPreset === '30') {
            matchExpiry = (daysLeft <= 30);
        } else if (expiryPreset === '60') {
            matchExpiry = (daysLeft <= 60);
        } else if (expiryPreset === 'custom') {
            const maxDays = isNaN(customDaysVal) ? 99999 : customDaysVal;
            matchExpiry = (daysLeft <= maxDays);
        }

        // 3. Kiểm tra kho
        let matchWh = !selectedWh || rowWh.includes(selectedWh);

        // 4. Kiểm tra trạng thái tồn
        let matchStatus = !selectedStatus || (rowStatus === selectedStatus);

        if (matchQuery && matchExpiry && matchWh && matchStatus) {
            r.style.display = '';
            visibleCount++;
        } else {
            r.style.display = 'none';
        }
    });

    const countEl = document.getElementById('filterCount_inventoryTable');
    if (countEl) {
        countEl.innerText = `${visibleCount} / ${rows.length} vị trí lô`;
    }
}
</script>