                <button type="submit" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-bold shadow">Xác Nhận Điều Chuyển</button>
            </div>
        </form>
    </div>
</div>

<%- include('admin-layout-bottom') %>

<!-- Modal Chỉnh Sửa Phiếu Nhập Kho (Admin) -->
<div id="modalAdminEditReceipt" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-6 relative">
        <button onclick="closeAdminEditReceiptModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-base font-bold text-gray-900 mb-2 flex items-center">
            <i class="fa-solid fa-pen-to-square text-blue-600 mr-2"></i> Chỉnh Sửa Phiếu Nhập Kho #<span id="adminEditReceiptIdText"></span>
        </h3>
        <p class="text-xs text-gray-500 mb-4">Cập nhật kho tiếp nhận, trạng thái hoặc số lượng/hạn sử dụng lô hàng (đồng bộ với Người bán).</p>

        <form action="/admin/logistics/inbound/update" method="POST" class="space-y-3.5 text-xs">
            <input type="hidden" id="adminEditReceiptId" name="receiptId">

            <div>
                <label class="block font-semibold text-gray-700 mb-1">Kho Tiếp Nhận *</label>
                <select id="adminEditWarehouseId" name="warehouseId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 bg-white">
                    <% warehouses.forEach(w => { %>
                        <option value="<%= w.WAREHOUSE_ID %>"><%= w.WAREHOUSE_NAME %> - <%= w.ADDRESS %></option>
                    <% }) %>
                </select>
            </div>

            <div>
                <label class="block font-semibold text-gray-700 mb-1">Trạng Thái Phiếu *</label>
                <select id="adminEditReceiptStatus" name="status" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 font-semibold bg-white">
                    <option value="PENDING">Chờ kiểm định & cất kệ (PENDING)</option>
                    <option value="COMPLETED">Đã cất kệ kho (COMPLETED)</option>
                    <option value="STOCK_REMOVED">Đã xóa khỏi kho (Hết tồn kho)</option>
                </select>
            </div>

            <div>
                <label class="block font-semibold text-gray-700 mb-1">Số Lượng Hàng Trong Lô (sp)</label>
                <input type="number" id="adminEditReceiptQuantity" name="quantity" min="1" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
            </div>

            <div>
                <label class="block font-semibold text-gray-700 mb-1">Hạn Sử Dụng (Expiry Date - YYYY-MM-DD)</label>
                <input type="date" id="adminEditReceiptExpiry" name="expiryDate" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
            </div>

            <div class="pt-3 flex justify-end space-x-2 border-t border-gray-100">
