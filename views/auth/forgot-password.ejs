<%- include('../partials/header') %>

<div class="max-w-md mx-auto px-4 py-12">
    <div class="bg-white rounded-sm shadow-md p-8 border border-gray-100">
        <!-- Header Quên Mật Khẩu -->
        <div class="flex items-center space-x-3 mb-6 pb-3 border-b border-gray-100">
            <a href="/login" class="text-gray-400 hover:text-[#ee4d2d] text-base">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="text-xl font-bold text-gray-900 leading-tight">Đặt Lại Mật Khẩu</h1>
                <p class="text-xs text-gray-400">Xác thực tài khoản an toàn qua Email</p>
            </div>
        </div>

        <% if (error) { %>
            <div id="errorAlertBox" class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded text-xs flex items-center">
                <i class="fa-solid fa-triangle-exclamation mr-2 text-sm shrink-0"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <% if (success) { %>
            <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-700 rounded text-xs flex items-center">
                <i class="fa-solid fa-circle-check mr-2 text-sm shrink-0"></i>
                <span><%= success %></span>
            </div>
        <% } %>

        <% if (step === 1) { %>
            <!-- BƯỚC 1: NHẬP EMAIL & KIỂM TRA ĐỊNH DẠNG @gmail.com -->
            <form action="/forgot-password/send-code" method="POST" onsubmit="return validateEmailStep1(event)" class="space-y-4 text-xs">
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Email Đăng Ký Tài Khoản *</label>
                    <input type="text" id="resetEmailInput" name="email" value="<%= email %>" required 
                           placeholder="Nhập email của bạn (ví dụ: buyer01@gmail.com)" 
                           class="w-full px-3 py-2.5 border border-gray-300 rounded focus:border-[#ee4d2d] focus:outline-none">
                    <p class="text-[11px] text-gray-400 mt-1">
                        <i class="fa-solid fa-circle-info mr-1 text-blue-500"></i> Email phải có đúng định dạng <strong class="text-gray-700">@gmail.com</strong>.
                    </p>
                </div>

                <button type="submit" id="btnSendCode" class="w-full py-3 bg-[#ee4d2d] hover:bg-[#d73211] text-white font-bold rounded text-xs uppercase tracking-wider shadow">
                    GỬI MÃ XÁC NHẬN
                </button>
            </form>
        <% } else { %>
            <!-- BƯỚC 2: NHẬP MÃ OTP (HẾT HẠN TRONG 20S), MẬT KHẨU MỚI & XÁC NHẬN MẬT KHẨU -->
            <form action="/forgot-password/reset" method="POST" onsubmit="return validateResetStep2(event)" class="space-y-4 text-xs">
                <input type="hidden" id="resetUserEmail" name="email" value="<%= email %>">

                <div class="bg-orange-50/70 border border-orange-200 p-3 rounded">
                    <span class="text-gray-500 text-[11px]">Email nhận mã OTP:</span>
                    <div class="font-bold text-gray-900 text-xs mt-0.5"><%= email %></div>
                </div>

                <!-- Ô nhập mã OTP kèm nút Gửi lại mã sau 20 giây -->
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Mã Xác Thực OTP (6 số) *</label>
                    <div class="flex space-x-2">
                        <input type="text" id="otpCodeInput" name="otp" required maxlength="6" 
                               placeholder="Nhập mã 6 số" 
                               class="flex-1 px-3 py-2.5 border border-gray-300 rounded focus:border-[#ee4d2d] focus:outline-none text-center font-mono text-base font-bold tracking-widest">
                        
                        <!-- Nút gửi lại mã đếm ngược 20s -->
                        <button type="button" id="btnResendOtp" onclick="resendOtpCode()" 
                                class="px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded font-semibold text-[11px] whitespace-nowrap">
                            Gửi lại (<span id="resendCountdown">20</span>s)
                        </button>
                    </div>
                    
                    <!-- Đồng hồ đếm ngược hiệu lực 20 giây -->
                    <div class="mt-1.5 flex items-center justify-between text-[11px]">
                        <span id="otpStatusText" class="text-amber-700 flex items-center font-medium">
                            <i class="fa-regular fa-clock mr-1"></i> Mã có hiệu lực trong: <strong id="otpTimer" class="ml-1 text-red-600">20s</strong>
                        </span>
                        <span class="text-gray-400">Không hiện trên web để bảo mật</span>
                    </div>
                </div>

                <!-- Mật khẩu mới có mắt ẩn/hiện -->
                <div class="relative">
                    <label class="block font-semibold text-gray-700 mb-1">Mật Khẩu Mới *</label>
                    <div class="relative">
                        <input type="password" id="newPassword" name="newPassword" required placeholder="Tối thiểu 6 ký tự" 
                               class="w-full px-3 py-2.5 border border-gray-300 rounded focus:border-[#ee4d2d] focus:outline-none pr-10">
                        <button type="button" onclick="togglePass('newPassword', 'eyeNew')" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                            <i id="eyeNew" class="fa-regular fa-eye-slash text-sm"></i>
                        </button>
                    </div>
                </div>

                <!-- Xác nhận mật khẩu mới có mắt ẩn/hiện -->
                <div class="relative">
                    <label class="block font-semibold text-gray-700 mb-1">Xác Nhận Mật Khẩu Mới *</label>
                    <div class="relative">
                        <input type="password" id="confirmNewPassword" name="confirmNewPassword" required placeholder="Nhập lại mật khẩu mới" 
                               class="w-full px-3 py-2.5 border border-gray-300 rounded focus:border-[#ee4d2d] focus:outline-none pr-10">
                        <button type="button" onclick="togglePass('confirmNewPassword', 'eyeConfirm')" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                            <i id="eyeConfirm" class="fa-regular fa-eye-slash text-sm"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" id="btnSubmitReset" class="w-full py-3 bg-[#ee4d2d] hover:bg-[#d73211] text-white font-bold rounded text-xs uppercase tracking-wider shadow">
                    XÁC NHẬN ĐẶT LẠI MẬT KHẨU
                </button>
            </form>
        <% } %>

        <div class="mt-6 text-center text-xs text-gray-500">
            Quay lại trang <a href="/login" class="text-[#ee4d2d] font-bold hover:underline">Đăng nhập</a>
        </div>
    </div>
</div>

<script>
// Kiểm tra định dạng @gmail.com ở Bước 1
function validateEmailStep1(e) {
    const email = document.getElementById('resetEmailInput').value.trim().toLowerCase();
    const gmailRegex = /^[a-zA-Z0-9._%+-]+@gmail\.com$/;
    if (!gmailRegex.test(email)) {
        alert('LỖI ĐỊNH DẠNG: Địa chỉ email bắt buộc phải có đuôi @gmail.com!');
        e.preventDefault();
        return false;
    }
    return true;
}

// Kiểm tra mật khẩu & xác nhận mật khẩu ở Bước 2
function validateResetStep2(e) {
    const p1 = document.getElementById('newPassword').value;
    const p2 = document.getElementById('confirmNewPassword').value;
    if (p1.length < 6) {
        alert('Mật khẩu mới phải có tối thiểu 6 ký tự!');
        e.preventDefault();
        return false;
    }
    if (p1 !== p2) {
        alert('Mật khẩu mới và xác nhận mật khẩu không trùng khớp!');
        e.preventDefault();
        return false;
    }
    return true;
}

// Đảo ẩn/hiện mật khẩu
function togglePass(inputId, eyeId) {
    const input = document.getElementById(inputId);
    const eye = document.getElementById(eyeId);
    if (input.type === 'password') {
        input.type = 'text';
        eye.classList.remove('fa-eye-slash');
        eye.classList.add('fa-eye');
    } else {
        input.type = 'password';
        eye.classList.remove('fa-eye');
        eye.classList.add('fa-eye-slash');
    }
}

// Xử lý đếm ngược 20 giây và Gửi lại mã OTP
<% if (step === 2) { %>
let countdownSecs = 20;
const timerEl = document.getElementById('otpTimer');
const btnResend = document.getElementById('btnResendOtp');
const resendCountEl = document.getElementById('resendCountdown');
const statusTextEl = document.getElementById('otpStatusText');
let intervalId = null;

function startCountdown() {
    countdownSecs = 20;
    btnResend.disabled = true;
    btnResend.classList.add('opacity-50', 'cursor-not-allowed');
    statusTextEl.innerHTML = '<i class="fa-regular fa-clock mr-1"></i> Mã có hiệu lực trong: <strong id="otpTimer" class="ml-1 text-red-600">20s</strong>';

    if (intervalId) clearInterval(intervalId);
    intervalId = setInterval(() => {
        countdownSecs--;
        if (document.getElementById('otpTimer')) {
            document.getElementById('otpTimer').innerText = countdownSecs + 's';
        }
        resendCountEl.innerText = countdownSecs;

        if (countdownSecs <= 0) {
            clearInterval(intervalId);
            statusTextEl.innerHTML = '<span class="text-red-600 font-bold"><i class="fa-solid fa-circle-xmark mr-1"></i> Mã đã hết hạn sau 20s! Vui lòng bấm gửi lại mã.</span>';
            btnResend.disabled = false;
            btnResend.classList.remove('opacity-50', 'cursor-not-allowed');
            btnResend.innerText = 'Gửi lại mã ngay';
        }
    }, 1000);
}

startCountdown();

async function resendOtpCode() {
    const email = document.getElementById('resetUserEmail').value;
    btnResend.innerText = 'Đang gửi...';
    btnResend.disabled = true;

    try {
        const res = await fetch('/forgot-password/send-code', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ email })
        });
        const data = await res.json();
        if (data.success) {
            alert('Mã xác thực mới đã được gửi về email của bạn! (Hiệu lực trong 20 giây)');
            document.getElementById('otpCodeInput').value = '';
            document.getElementById('otpCodeInput').focus();
            btnResend.innerHTML = 'Gửi lại (<span id="resendCountdown">20</span>s)';
            startCountdown();
        } else {
            alert(data.message || 'Lỗi khi gửi lại mã!');
            btnResend.innerText = 'Gửi lại mã ngay';
            btnResend.disabled = false;
        }
    } catch (e) {
        alert('Lỗi kết nối máy chủ!');
        btnResend.innerText = 'Gửi lại mã ngay';
        btnResend.disabled = false;
    }
}
<% } %>
</script>

<%- include('../partials/footer') %>
