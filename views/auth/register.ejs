<%- include('../partials/header') %>

<div class="max-w-md mx-auto px-4 py-12">
    <div class="bg-white rounded-sm shadow-md p-8 border border-gray-100">
        <h1 class="text-xl font-bold text-gray-900 mb-6">Đăng Ký Tài Khoản</h1>

        <% if (error) { %>
            <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded text-xs flex items-center">
                <i class="fa-solid fa-triangle-exclamation mr-2 text-sm"></i> <%= error %>
            </div>
        <% } %>

        <form action="/register" method="POST" class="space-y-3.5 text-xs">
            <!-- Loại tài khoản -->
            <div>
                <label class="block font-semibold text-gray-700 mb-1">Loại Tài Khoản *</label>
                <div class="grid grid-cols-2 gap-3">
                    <label class="border p-2.5 rounded flex items-center cursor-pointer hover:border-[#ee4d2d]">
                        <input type="radio" name="roleType" value="CUSTOMER" checked onchange="toggleShopNameInput(false)" class="text-[#ee4d2d] mr-2">
                        <span class="font-bold text-gray-800">Khách Hàng</span>
                    </label>
                    <label class="border p-2.5 rounded flex items-center cursor-pointer hover:border-purple-600">
                        <input type="radio" name="roleType" value="SHOPKEEPER" onchange="toggleShopNameInput(true)" class="text-purple-600 mr-2">
                        <span class="font-bold text-gray-800">Người Bán (Shop)</span>
                    </label>
                </div>
            </div>

            <div id="shopNameContainer" class="hidden">
                <label class="block font-semibold text-gray-700 mb-1">Tên Gian Hàng *</label>
                <input type="text" name="shopName" placeholder="VD: Vinamilk Official Store" class="w-full px-3 py-2 border border-gray-300 rounded focus:border-[#ee4d2d] focus:outline-none">
            </div>

            <!-- Email (@gmail.com) -->
            <div>
                <label class="block font-semibold text-gray-700 mb-1">Địa Chỉ Email (@gmail.com) *</label>
                <input type="text" id="regEmail" name="email" value="<%= oldEmail %>" required placeholder="user@gmail.com" class="w-full px-3 py-2 border border-gray-300 rounded focus:border-[#ee4d2d] focus:outline-none">
                <p class="text-[10px] text-gray-400 mt-0.5">Bắt buộc phải là định dạng @gmail.com</p>
            </div>

            <!-- Mật khẩu có mắt ẩn hiện -->
            <div class="relative">
                <label class="block font-semibold text-gray-700 mb-1">Mật Khẩu *</label>
                <div class="relative">
                    <input type="password" id="regPassword" name="password" required placeholder="Tối thiểu 6 ký tự" class="w-full px-3 py-2 border border-gray-300 rounded focus:border-[#ee4d2d] focus:outline-none pr-10">
                    <button type="button" onclick="togglePassField('regPassword', 'regEyeIcon')" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                        <i id="regEyeIcon" class="fa-regular fa-eye-slash text-sm"></i>
                    </button>
                </div>
            </div>

            <!-- Xác nhận mật khẩu có mắt ẩn hiện -->
            <div class="relative">
                <label class="block font-semibold text-gray-700 mb-1">Xác Nhận Mật Khẩu *</label>
                <div class="relative">
                    <input type="password" id="regConfirmPassword" name="confirmPassword" required placeholder="Nhập lại mật khẩu" class="w-full px-3 py-2 border border-gray-300 rounded focus:border-[#ee4d2d] focus:outline-none pr-10">
                    <button type="button" onclick="togglePassField('regConfirmPassword', 'regConfirmEyeIcon')" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                        <i id="regConfirmEyeIcon" class="fa-regular fa-eye-slash text-sm"></i>
                    </button>
                </div>
            </div>

            <div>
                <label class="block font-semibold text-gray-700 mb-1">Họ và Tên *</label>
                <input type="text" name="fullName" value="<%= oldName %>" required placeholder="Nguyễn Văn A" class="w-full px-3 py-2 border border-gray-300 rounded focus:border-[#ee4d2d] focus:outline-none">
            </div>

            <div>
                <label class="block font-semibold text-gray-700 mb-1">Số Điện Thoại</label>
                <input type="tel" name="phone" placeholder="0901234567" class="w-full px-3 py-2 border border-gray-300 rounded focus:border-[#ee4d2d] focus:outline-none">
            </div>

            <button type="submit" class="w-full py-3 bg-[#ee4d2d] hover:bg-[#d73211] text-white font-bold rounded text-xs uppercase tracking-wider shadow mt-2">
                ĐĂNG KÝ
            </button>
        </form>

        <div class="mt-6 text-center text-xs text-gray-500">
            Bạn đã có tài khoản? <a href="/login" class="text-[#ee4d2d] font-bold hover:underline">Đăng nhập</a>
        </div>
    </div>
</div>

<script>
function toggleShopNameInput(show) {
    const box = document.getElementById('shopNameContainer');
    if (show) box.classList.remove('hidden');
    else box.classList.add('hidden');
}

function togglePassField(inputId, eyeId) {
    const input = document.getElementById(inputId);
    const eye = document.getElementById(eyeId);
    if (input.type === 'password') {
        input.type = 'text';
        eye.classList.remove('fa-eye-slash');
        eye.classList.add('fa-eye');
    } else {
        input.type = 'password';
        eye.classList.remove('fa-eye');
        eye.classList.add('fa-eye-slash');
    }
}
</script>

<%- include('../partials/footer') %>
