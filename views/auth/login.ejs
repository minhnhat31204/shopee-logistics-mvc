<%- include('../partials/header') %>

<div class="max-w-md mx-auto px-4 py-12">
    <div class="bg-white rounded-sm shadow-md p-8 border border-gray-100">
        <h1 class="text-xl font-bold text-gray-900 mb-6">Đăng Nhập</h1>

        <% if (error) { %>
            <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded text-xs flex items-center">
                <i class="fa-solid fa-triangle-exclamation mr-2 text-sm"></i> <%= error %>
            </div>
        <% } %>

        <% if (success) { %>
            <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-700 rounded text-xs flex items-center">
                <i class="fa-solid fa-circle-check mr-2 text-sm"></i> <%= success %>
            </div>
        <% } %>

        <form id="loginForm" action="/login" method="POST" class="space-y-4 text-xs">
            <input type="hidden" name="redirect" value="<%= redirect %>">

            <!-- 1. Ô nhập Email có gợi ý tài khoản vừa đăng nhập gần đây (Yêu cầu 1 & 2) -->
            <div class="relative">
                <label class="block font-semibold text-gray-700 mb-1">Email Đăng Ký Tài Khoản *</label>
                <input type="email" id="loginEmail" name="email" value="<%= oldEmail %>" required 
                       placeholder="Email của bạn (VD: buyer01@gmail.com)" 
                       autocomplete="email"
                       class="w-full px-3 py-2.5 border border-gray-300 rounded focus:border-[#ee4d2d] focus:outline-none">
                
                <!-- Dropdown gợi ý tài khoản đã lưu gần đây (Yêu cầu 2) -->
                <div id="savedAccountsDropdown" class="absolute left-0 right-0 top-full mt-1 bg-white border border-gray-200 rounded shadow-lg hidden z-30 divide-y divide-gray-100">
                    <div class="p-2 text-[10px] text-gray-400 uppercase font-bold bg-gray-50">Tài khoản đã đăng nhập gần đây:</div>
                    <div id="savedAccountsList"></div>
                </div>
            </div>

            <!-- 2. Ô nhập Mật khẩu có icon Mắt ẩn/hiện (Yêu cầu 2) -->
            <div class="relative">
                <label class="block font-semibold text-gray-700 mb-1">Mật Khẩu *</label>
                <div class="relative">
                    <input type="password" id="loginPassword" name="password" required 
                           placeholder="Mật khẩu của bạn" 
                           class="w-full px-3 py-2.5 border border-gray-300 rounded focus:border-[#ee4d2d] focus:outline-none pr-10">
                    <button type="button" onclick="togglePasswordVisibility()" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                        <i id="eyeIcon" class="fa-regular fa-eye-slash text-sm"></i>
                    </button>
                </div>
            </div>

            <!-- Ghi nhớ đăng nhập (Yêu cầu 2) -->
            <div class="flex items-center justify-between text-xs text-gray-600 pt-1">
                <label class="flex items-center space-x-2 cursor-pointer">
                    <input type="checkbox" id="rememberMe" name="rememberMe" checked class="rounded text-[#ee4d2d] focus:ring-[#ee4d2d]">
                    <span>Ghi nhớ thông tin đăng nhập</span>
                </label>
                <a href="/forgot-password" class="text-blue-900 hover:text-[#ee4d2d] hover:underline font-medium">Quên mật khẩu?</a>
            </div>

            <!-- Nút submit (Disable nếu đang bị khóa) -->
            <button type="submit" id="loginSubmitBtn" class="w-full py-3 bg-[#ee4d2d] hover:bg-[#d73211] text-white font-bold rounded text-xs uppercase tracking-wider shadow">
                ĐĂNG NHẬP
            </button>
        </form>

        <div class="mt-6 text-center text-xs text-gray-500">
            Bạn mới biết đến Shopee? <a href="/register" class="text-[#ee4d2d] font-bold hover:underline">Đăng ký</a>
        </div>
    </div>
</div>

<script>
// 1. Ẩn/Hiện mật khẩu bằng icon mắt (Yêu cầu 2)
function togglePasswordVisibility() {
    const pwdInput = document.getElementById('loginPassword');
    const eyeIcon = document.getElementById('eyeIcon');
    if (pwdInput.type === 'password') {
        pwdInput.type = 'text';
        eyeIcon.classList.remove('fa-eye-slash');
        eyeIcon.classList.add('fa-eye');
    } else {
        pwdInput.type = 'password';
        eyeIcon.classList.remove('fa-eye');
        eyeIcon.classList.add('fa-eye-slash');
    }
}

// 2. Gợi ý tài khoản vừa đăng nhập gần đây qua LocalStorage (Có nút X để xóa từng tài khoản)
document.addEventListener('DOMContentLoaded', () => {
    const emailInput = document.getElementById('loginEmail');
    const pwdInput = document.getElementById('loginPassword');
    const dropdown = document.getElementById('savedAccountsDropdown');
    const list = document.getElementById('savedAccountsList');

    function renderSavedAccounts() {
        let saved = JSON.parse(localStorage.getItem('shopee_saved_accounts') || '[]');
        if (saved.length > 0) {
            list.innerHTML = '';
            saved.forEach((acc, index) => {
                const item = document.createElement('div');
                item.className = 'p-2.5 hover:bg-orange-50 cursor-pointer flex items-center justify-between text-xs text-gray-700 transition group/acc';
                item.innerHTML = `
                    <div class="flex-1 truncate mr-2" onclick="selectSavedAccount('${acc.email}', '${acc.password || ''}')">
                        <span class="font-bold text-[#ee4d2d]">${acc.email}</span>
                        <span class="text-[10px] text-gray-400 block">${acc.name || 'Người dùng'}</span>
                    </div>
                    <div class="flex items-center space-x-1.5">
                        <button type="button" onclick="deleteSavedAccount(event, ${index})" title="Xóa tài khoản này khỏi danh sách gợi ý" class="text-gray-400 hover:text-red-600 text-xs p-1 rounded hover:bg-gray-200">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                `;
                list.appendChild(item);
            });
        } else {
            dropdown.classList.add('hidden');
        }
    }

    window.selectSavedAccount = function(email, password) {
        emailInput.value = email;
        if (password) pwdInput.value = password;
        dropdown.classList.add('hidden');
    };

    window.deleteSavedAccount = function(e, index) {
        e.stopPropagation();
        e.preventDefault();
        let saved = JSON.parse(localStorage.getItem('shopee_saved_accounts') || '[]');
        saved.splice(index, 1);
        localStorage.setItem('shopee_saved_accounts', JSON.stringify(saved));
        renderSavedAccounts();
    };

    renderSavedAccounts();

    emailInput.addEventListener('focus', () => {
        let saved = JSON.parse(localStorage.getItem('shopee_saved_accounts') || '[]');
        if (saved.length > 0) dropdown.classList.remove('hidden');
    });
    
    document.addEventListener('click', (e) => {
        if (!emailInput.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.classList.add('hidden');
        }
    });

    // Đếm ngược khóa tài khoản nếu có (Yêu cầu 3)
    let lockSec = <%= Number(lockSeconds || 0) %>;
    if (lockSec > 0) {
        const btn = document.getElementById('loginSubmitBtn');
        btn.disabled = true;
        btn.classList.add('opacity-50', 'cursor-not-allowed');
        const interval = setInterval(() => {
            btn.innerText = `TẠM KHÓA (${lockSec}s)`;
            lockSec--;
            if (lockSec < 0) {
                clearInterval(interval);
                btn.disabled = false;
                btn.classList.remove('opacity-50', 'cursor-not-allowed');
                btn.innerText = 'ĐĂNG NHẬP';
            }
        }, 1000);
    }

    // Lưu vào LocalStorage khi submit form
    document.getElementById('loginForm').addEventListener('submit', () => {
        const em = emailInput.value.trim();
        const pw = pwdInput.value.trim();
        if (em) {
            let accounts = JSON.parse(localStorage.getItem('shopee_saved_accounts') || '[]');
            accounts = accounts.filter(a => a.email !== em);
            accounts.unshift({ email: em, password: pw, name: em.split('@')[0] });
            localStorage.setItem('shopee_saved_accounts', JSON.stringify(accounts.slice(0, 5)));
        }
    });
});
</script>

<%- include('../partials/footer') %>
