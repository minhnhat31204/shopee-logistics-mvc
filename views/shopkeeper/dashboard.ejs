<%- include('shop-layout-top') %>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
    <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100 flex items-center justify-between">
        <div>
            <p class="text-xs text-gray-500 font-medium uppercase tracking-wider">Sản Phẩm Đang Bán</p>
            <h3 class="text-2xl font-bold text-gray-900 mt-1"><%= stats.productCount %></h3>
            <p class="text-xs text-purple-600 mt-1"><i class="fa-solid fa-boxes-stacked mr-1"></i>Tại kho tổng</p>
        </div>
        <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center text-xl">
            <i class="fa-solid fa-box-archive"></i>
        </div>
    </div>

    <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100 flex items-center justify-between">
        <div>
            <p class="text-xs text-gray-500 font-medium uppercase tracking-wider">Tổng Phiếu Nhập Kho</p>
            <h3 class="text-2xl font-bold text-gray-900 mt-1"><%= stats.receiptCount %></h3>
            <p class="text-xs text-indigo-600 mt-1"><i class="fa-solid fa-receipt mr-1"></i>INBOUND_RECEIPTS</p>
        </div>
        <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center text-xl">
            <i class="fa-solid fa-file-invoice"></i>
        </div>
    </div>

    <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100 flex items-center justify-between">
        <div>
            <p class="text-xs text-gray-500 font-medium uppercase tracking-wider">Phiếu Đang Chờ Cất Kho</p>
            <h3 class="text-2xl font-bold text-yellow-600 mt-1"><%= stats.pendingReceipts %></h3>
            <p class="text-xs text-yellow-600 mt-1"><i class="fa-solid fa-clock mr-1"></i>Admin sẽ duyệt cất kệ</p>
        </div>
        <div class="w-12 h-12 bg-yellow-50 text-yellow-600 rounded-xl flex items-center justify-center text-xl">
            <i class="fa-solid fa-hourglass-half"></i>
        </div>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="p-4 border-b border-gray-100 flex justify-between items-center">
        <h3 class="font-bold text-gray-900 flex items-center text-sm">
            <i class="fa-solid fa-clock-rotate-left text-purple-600 mr-2 text-base"></i> Các Phiếu Nhập Kho Gần Đây Của Gian Hàng
        </h3>
        <a href="/shop/inbound" class="text-xs font-semibold text-purple-600 hover:underline">Tạo phiếu nhập mới &rarr;</a>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-gray-600">
            <thead class="bg-gray-50 text-gray-500 uppercase tracking-wider text-[11px]">
                <tr>
                    <th class="p-3">Mã Phiếu</th>
                    <th class="p-3">Kho Đến</th>
                    <th class="p-3">Số Lô Hàng</th>
                    <th class="p-3">Tổng Số Lượng</th>
                    <th class="p-3">Thời Gian Tạo</th>
                    <th class="p-3">Trạng Thái</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <% if (recentReceipts.length === 0) { %>
                    <tr><td colspan="6" class="p-4 text-center text-gray-400">Chưa có phiếu nhập nào.</td></tr>
                <% } else { %>
                    <% recentReceipts.forEach(r => { %>
                        <tr class="hover:bg-gray-50">
                            <td class="p-3 font-mono font-bold text-purple-700">#<%= r.RECEIPT_ID %></td>
                            <td class="p-3 font-medium text-gray-800"><%= r.WAREHOUSE_NAME %></td>
                            <td class="p-3 font-semibold text-gray-700"><%= r.TOTAL_BATCHES %> lô</td>
                            <td class="p-3 font-bold text-gray-900"><%= r.TOTAL_QUANTITY %> sp</td>
                            <td class="p-3 text-gray-400"><%= r.CREATED_AT %></td>
                            <td class="p-3">
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold <%= r.STATUS === 'COMPLETED' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-800' %>">
                                    <%= r.STATUS %>
                                </span>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('shop-layout-bottom') %>
